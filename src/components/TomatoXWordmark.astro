---
// TomatoXWordmark.astro
// 硬朗、男性化、几何工业风的极客艺术字标 (Masculine Geometric Tech Wordmark)
// 特征：45° 机械斜切倒角、粗壮扎实的工程字重、利刃张力 X 字符，彻底去除柔和卷曲藤蔓
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showSubtitle?: boolean;
  subtitleText?: string;
  class?: string;
}

const {
  size = 'sm',
  showSubtitle = false,
  subtitleText = 'XUJIURAN.TOP · PRODUCT ENGINEER',
  class: className = '',
} = Astro.props;

// 尺寸映射 (与 Header/Hero 行高完美对齐，不破坏任何原有排版)
const heightClass = {
  sm: 'h-6 sm:h-7',
  md: 'h-9 sm:h-10',
  lg: 'h-13 sm:h-15',
}[size];
---

<div class:list={['inline-flex flex-col items-start leading-none', className]}>
  <svg
    class:list={[heightClass, 'w-auto max-w-full drop-shadow-xs transition-transform group-hover:scale-[1.02]']}
    viewBox="0 0 350 76"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="TomatoX"
    role="img"
  >
    <defs>
      <!-- Industrial Racing Crimson Gradient -->
      <linearGradient id="masc-red" x1="0" y1="10" x2="320" y2="70" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#EF4444"/>
        <stop offset="60%" stop-color="#DC2626"/>
        <stop offset="100%" stop-color="#991B1B"/>
      </linearGradient>

      <!-- Stealth Carbon Dark / Edge Tint -->
      <linearGradient id="masc-dark" x1="260" y1="10" x2="340" y2="70" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#27272A"/>
        <stop offset="100%" stop-color="#09090B"/>
      </linearGradient>

      <!-- Cyber Neon Emerald Accent (Precision Cut) -->
      <linearGradient id="masc-cyber" x1="260" y1="10" x2="340" y2="70" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#34D399"/>
        <stop offset="100%" stop-color="#059669"/>
      </linearGradient>
    </defs>

    <!-- 'TOMATO' Bold Geometric Industrial Lettering -->
    <g fill="url(#masc-red)">
      <!-- T: 45° Precision Chamfer + Heavy Sturdy Stem -->
      <path d="M12 28L22 18H58V30H41V68H29V30H12V28Z"/>
      <!-- Sharp Geometric Diamond Accent on T (Hard-edged Calyx) -->
      <polygon points="35,13 42,7 49,13 42,17" fill="url(#masc-cyber)"/>

      <!-- O: Industrial Squircle / Hexagonal Tension -->
      <path d="M72 18H96L108 30V56L96 68H72L60 56V30L72 18ZM74 30V56H94V30H74Z"/>

      <!-- M: Muscular Architecture with Sharp Chisel Center -->
      <path d="M117 18H130L142 42L154 18H167V68H155V35L145 54H139L129 35V68H117V18Z"/>

      <!-- A: Trapezoidal Sturdy Frame with Cutout -->
      <path d="M184 18H198L212 68H199L196 56H185L182 68H170L184 18ZM193 45L191 32L188 45H193Z"/>

      <!-- T: Matching Chamfer Architecture -->
      <path d="M218 18H252V30H241V68H229V30H218V18Z"/>

      <!-- O: Matching Heavy Squircle -->
      <path d="M262 18H284L294 28V58L284 68H262L252 58V28L262 18ZM264 30V56H282V30H264Z"/>
    </g>

    <!-- 'X': The Aggressive, Razor-Sharp Tech Emblem (利刃切角与锋芒交叉) -->
    <g id="masc-x">
      <!-- Primary Diagonal Blade (Top-Left to Bottom-Right) in Deep Crimson -->
      <path d="M298 18H313L348 68H333L298 18Z" fill="url(#masc-red)"/>

      <!-- Counter Diagonal Blade (Bottom-Left to Top-Right) with 45° Stealth Facets -->
      <path d="M298 68H313L328 47L322 38L298 68Z" fill="#B91C1C"/>
      <path d="M327 31L333 22L348 18L334 38L327 31Z" fill="#EF4444"/>

      <!-- Center Dynamic Laser Slice (Cyber Green Slit Cutting Through) -->
      <polygon points="314,40 329,40 334,46 319,46" fill="url(#masc-cyber)"/>
      <!-- Sharp Mechanical Arrow Notch -->
      <polygon points="342,18 349,18 349,25" fill="#10B981"/>
    </g>
  </svg>

  {showSubtitle && (
    <span class="mt-1 text-[10px] tracking-widest mono text-[var(--text-secondary)] font-bold pl-0.5 uppercase">
      {subtitleText}
    </span>
  )}
</div>
