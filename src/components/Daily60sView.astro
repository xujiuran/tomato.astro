---
import type { Daily60sData } from '../lib/newsService';

interface Props {
  initialData: Daily60sData;
}

const { initialData } = Astro.props;
---

<div id="daily-60s-container" class="space-y-6">
  <!-- Date & Info Header Card -->
  <div class="relative overflow-hidden rounded-xl border border-[var(--border-primary)] bg-[var(--card-bg)] p-5 sm:p-6 shadow-xs transition-all">
    <!-- Top Decorative Gradient Line -->
    <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-red-500 via-orange-500 to-amber-500"></div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-red-500/10 px-2.5 py-0.5 text-xs font-medium text-red-600 dark:text-red-400">
            <span class="h-1.5 w-1.5 rounded-full bg-red-500 animate-pulse"></span>
            60s 看世界
          </span>
          <span id="news-date-text" class="mono text-xs text-[var(--text-secondary)]">
            {initialData.date} · {initialData.dayOfWeek}
          </span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-primary)]">
          每天 60 秒读懂世界
        </h2>
        <p class="text-xs text-[var(--text-tertiary)] mono">
          数据来源于 <a href="https://github.com/vikiboss/60s" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--text-secondary)]">vikiboss/60s</a> · 晨间自动整理
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-2">
        <button
          id="btn-copy-60s"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-primary)] bg-[var(--bg-secondary)] px-3 py-1.5 text-xs font-medium text-[var(--text-primary)] transition-all hover:border-[var(--accent)] hover:text-[var(--accent)] hover:shadow-xs active:scale-95"
          title="复制今日纯文本早报"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copy-btn-text">复制早报</span>
        </button>

        {initialData.image && (
          <a
            id="btn-view-image"
            href={initialData.image}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-primary)] bg-[var(--bg-secondary)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] transition-all hover:text-[var(--text-primary)] hover:border-[var(--text-secondary)]"
            title="查看原版高清图文海报"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span>海报长图</span>
          </a>
        )}

        <button
          id="btn-refresh-60s"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-primary)] bg-[var(--bg-secondary)] px-2.5 py-1.5 text-xs text-[var(--text-secondary)] transition-all hover:text-[var(--text-primary)] active:rotate-180"
          title="刷新最新数据"
        >
          <svg id="refresh-spinner" class="h-3.5 w-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 4v6h-6"></path>
            <path d="M1 20v-6h6"></path>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Tip of the Day / 微语 Block -->
    {initialData.tip && (
      <div id="tip-card" class="mt-4 rounded-lg bg-[var(--bg-secondary)] p-3.5 border-l-3 border-orange-500/70 text-xs sm:text-sm">
        <div class="flex items-start gap-2.5">
          <span class="text-orange-500 font-bold shrink-0 serif-title">「微语」</span>
          <p id="tip-text" class="text-[var(--text-primary)] italic font-normal leading-relaxed">
            {initialData.tip}
          </p>
        </div>
      </div>
    )}
  </div>

  <!-- News List Items -->
  <div class="rounded-xl border border-[var(--border-primary)] bg-[var(--card-bg)] p-4 sm:p-6 shadow-xs">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--border-secondary)] mb-4">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[var(--accent)]"></span>
        <h3 class="text-sm font-semibold text-[var(--text-primary)]">
          今日要闻摘录
        </h3>
        <span id="news-count-badge" class="mono text-[11px] text-[var(--text-tertiary)] bg-[var(--bg-secondary)] px-2 py-0.5 rounded">
          共 {initialData.news.length} 条
        </span>
      </div>
      <div class="text-[11px] text-[var(--text-tertiary)] mono">
        点击条目可标记阅读状态
      </div>
    </div>

    <ul id="news-list" class="divide-y divide-[var(--border-secondary)]">
      {initialData.news.map((item, index) => {
        const num = String(index + 1).padStart(2, '0');
        return (
          <li
            class="news-item group flex items-start gap-3.5 py-3.5 transition-colors hover:bg-[var(--bg-secondary)]/50 rounded-lg px-2 -mx-2 cursor-pointer select-none"
            data-index={index}
          >
            <span class="mono text-xs font-semibold text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors mt-0.5 shrink-0 w-6">
              {num}
            </span>
            <div class="flex-1 min-w-0">
              <p class="news-text text-sm sm:text-[14.5px] leading-relaxed text-[var(--text-primary)] group-hover:text-[var(--text-primary)] transition-colors">
                {item}
              </p>
            </div>
            <span class="read-check opacity-0 group-hover:opacity-40 transition-opacity text-xs text-[var(--text-tertiary)] shrink-0 mt-0.5">
              ✓
            </span>
          </li>
        );
      })}
    </ul>

    <!-- Footer meta -->
    <div class="mt-6 pt-4 border-t border-[var(--border-secondary)] flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-[var(--text-tertiary)]">
      <span class="mono">更新时间：{initialData.updated}</span>
      <div class="flex items-center gap-3">
        <button id="btn-copy-bottom" type="button" class="hover:text-[var(--accent)] transition-colors">
          复制全文
        </button>
        <span>·</span>
        <a href={initialData.link} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent)] transition-colors">
          微信发布页 ↗
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Client-side interactions for 60s
  function setup60sInteractions() {
    const list = document.getElementById('news-list');
    const copyBtn = document.getElementById('btn-copy-60s');
    const copyBtnBottom = document.getElementById('btn-copy-bottom');
    const copyText = document.getElementById('copy-btn-text');
    const refreshBtn = document.getElementById('btn-refresh-60s');
    const spinner = document.getElementById('refresh-spinner');

    // Click to toggle read state
    list?.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest('.news-item');
      if (!item) return;
      item.classList.toggle('opacity-40');
      const check = item.querySelector('.read-check');
      if (check) {
        check.classList.toggle('opacity-100');
        check.classList.toggle('text-emerald-500');
      }
    });

    // Copy to clipboard
    const handleCopy = async () => {
      const items = Array.from(document.querySelectorAll('.news-text')).map((el, idx) => {
        return `${idx + 1}. ${(el.textContent || '').trim()}`;
      });
      const dateText = document.getElementById('news-date-text')?.textContent?.trim() || '';
      const tipText = document.getElementById('tip-text')?.textContent?.trim() || '';

      const fullText = [
        `【每天 60 秒读懂世界】(${dateText})`,
        '',
        ...items,
        '',
        tipText ? `【微语】${tipText}` : '',
        '',
        '—— 来自 TomatoX 随笔 (xujiuran.top/news)'
      ].filter(Boolean).join('\n');

      try {
        await navigator.clipboard.writeText(fullText);
        if (copyText) copyText.textContent = '已复制！';
        setTimeout(() => {
          if (copyText) copyText.textContent = '复制早报';
        }, 2000);
      } catch (err) {
        console.error('Copy failed', err);
      }
    };

    copyBtn?.addEventListener('click', handleCopy);
    copyBtnBottom?.addEventListener('click', handleCopy);

    // Refresh data
    refreshBtn?.addEventListener('click', async () => {
      spinner?.classList.add('animate-spin');
      try {
        const today = new Date().toISOString().slice(0, 10);
        const res = await fetch(`https://cdn.jsdelivr.net/gh/vikiboss/60s-static-host@main/static/60s/${today}.json?t=${Date.now()}`);
        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data.news)) {
            // Update items
            if (list) {
              list.innerHTML = data.news.map((item: string, idx: number) => {
                const num = String(idx + 1).padStart(2, '0');
                return `
                  <li class="news-item group flex items-start gap-3.5 py-3.5 transition-colors hover:bg-[var(--bg-secondary)]/50 rounded-lg px-2 -mx-2 cursor-pointer select-none">
                    <span class="mono text-xs font-semibold text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors mt-0.5 shrink-0 w-6">
                      ${num}
                    </span>
                    <div class="flex-1 min-w-0">
                      <p class="news-text text-sm sm:text-[14.5px] leading-relaxed text-[var(--text-primary)]">
                        ${item}
                      </p>
                    </div>
                    <span class="read-check opacity-0 group-hover:opacity-40 transition-opacity text-xs text-[var(--text-tertiary)] shrink-0 mt-0.5">
                      ✓
                    </span>
                  </li>
                `;
              }).join('');
            }
            const tipEl = document.getElementById('tip-text');
            if (tipEl && data.tip) tipEl.textContent = data.tip;
          }
        }
      } catch (e) {
        console.warn('Refresh error', e);
      } finally {
        setTimeout(() => {
          spinner?.classList.remove('animate-spin');
        }, 500);
      }
    });
  }

  // Run on mount
  setup60sInteractions();
  document.addEventListener('astro:page-load', setup60sInteractions);
</script>
