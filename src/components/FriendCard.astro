---
// FriendCard.astro
import type { FriendLink } from '../data/friends';

interface Props extends FriendLink {}

const { name, url, description, author, avatar, tag, badge, primaryColor } = Astro.props;

let hostname = '';
try {
  hostname = new URL(url).hostname.replace(/^www\./, '');
} catch {
  hostname = url;
}

const isDivergence = url.includes('drleaves.icu') || name.toLowerCase().includes('divergence');
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="friend-card group relative flex flex-col justify-between rounded-xl border border-[var(--border-primary)] bg-[var(--card-bg)] p-4 sm:p-5 transition-all duration-200 hover:-translate-y-1 hover:border-[var(--accent)] hover:shadow-md"
>
  <div>
    <!-- Top Row: Avatar & Header Meta -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3 min-w-0">
        <!-- Avatar / Mark Icon -->
        <div class="relative h-12 w-12 rounded-xl border border-[var(--border-secondary)] bg-[var(--surface-subtle)] p-1 shrink-0 flex items-center justify-center overflow-hidden shadow-xs group-hover:scale-105 group-hover:shadow-sm transition-all duration-200">
          {avatar ? (
            <img
              src={avatar}
              alt={`${name} 头像`}
              width="48"
              height="48"
              decoding="async"
              class="h-full w-full object-cover rounded-lg"
              loading="lazy"
            />
          ) : isDivergence ? (
            <div class="h-full w-full rounded-lg bg-gradient-to-br from-amber-500/20 via-orange-500/15 to-red-500/20 flex flex-col items-center justify-center border border-amber-500/30">
              <span class="text-amber-500 text-lg font-bold select-none leading-none">◇</span>
              <span class="mono text-[8px] text-amber-600 dark:text-amber-400 font-extrabold tracking-tighter mt-0.5">1.048</span>
            </div>
          ) : (
            <div class="h-full w-full rounded-lg bg-[var(--accent)]/10 text-[var(--accent)] flex items-center justify-center font-bold text-lg select-none">
              {name.charAt(0)}
            </div>
          )}
        </div>

        <div class="min-w-0">
          <div class="flex items-center gap-1.5 flex-wrap">
            <h3 class="text-sm sm:text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors truncate">
              {name}
            </h3>
            {badge && (
              <span class="mono text-[10px] text-[var(--accent)] bg-[var(--accent)]/10 px-1.5 py-0.5 rounded font-medium">
                {badge}
              </span>
            )}
          </div>
          <div class="flex items-center gap-2 text-xs text-[var(--text-tertiary)] mono mt-0.5 truncate">
            <span>{hostname}</span>
            {author && (
              <>
                <span>·</span>
                <span class="text-[var(--text-secondary)]">{author}</span>
              </>
            )}
          </div>
        </div>
      </div>

      <!-- Outlink Arrow Indicator -->
      <div class="text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors shrink-0 p-1">
        <svg
          class="h-4 w-4 transform transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </div>
    </div>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] line-clamp-2 leading-relaxed mb-3">
      {description}
    </p>
  </div>

  <!-- Footer Tag info -->
  {tag && (
    <div class="pt-2 border-t border-[var(--border-secondary)] flex items-center justify-between text-[11px] text-[var(--text-tertiary)]">
      <span class="inline-flex items-center gap-1">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]/70"></span>
        <span>{tag}</span>
      </span>
      <span class="mono text-[10px] opacity-0 group-hover:opacity-100 transition-opacity text-[var(--accent)]">
        直达访问 →
      </span>
    </div>
  )}
</a>
