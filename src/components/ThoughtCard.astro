---
// ThoughtCard.astro
interface Props {
  id: number;
  date: string;
  content: string;
}

const { id, date, content } = Astro.props;
---

<div class="relative group rounded-xl border border-[var(--border-primary)] bg-[var(--card-bg)] p-4 transition-all hover:border-[var(--text-secondary)] shadow-2xs">
  <div class="flex items-center justify-between text-xs text-[var(--text-secondary)] mb-2.5">
    <div class="flex items-center gap-2">
      <span class="mono font-semibold text-[var(--accent)]">#{id}</span>
      <span>·</span>
      <time>{date}</time>
    </div>

    <!-- Share Poster Button -->
    <button
      type="button"
      class="thought-poster-btn inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[11px] text-[var(--text-tertiary)] hover:text-[var(--accent)] hover:bg-[var(--surface-subtle)] transition-colors opacity-80 sm:opacity-0 group-hover:opacity-100 cursor-pointer"
      data-id={id}
      data-date={date}
      data-content={content}
      title="一键生成分享卡片海报"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
      <span>生成卡片</span>
    </button>
  </div>

  <p class="text-xs sm:text-sm text-[var(--text-primary)] leading-relaxed whitespace-pre-line">
    {content}
  </p>
</div>

<script>
  function setupThoughtPosterButtons() {
    const buttons = document.querySelectorAll('.thought-poster-btn');
    buttons.forEach((btn) => {
      if ((btn as any)._hasPosterHandler) return;
      (btn as any)._hasPosterHandler = true;

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-id') || '';
        const date = btn.getAttribute('data-date') || '';
        const content = btn.getAttribute('data-content') || '';

        window.dispatchEvent(
          new CustomEvent('tomatox:open-poster', {
            detail: {
              type: 'thought',
              id,
              date,
              content,
            },
          })
        );
      });
    });
  }

  setupThoughtPosterButtons();
  document.addEventListener('astro:page-load', setupThoughtPosterButtons);
</script>
