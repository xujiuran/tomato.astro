---
import type { HotNewsSource } from '../lib/newsService';

interface Props {
  initialSources: HotNewsSource[];
}

const { initialSources } = Astro.props;

// Group sources by column
const techSources = initialSources.filter((s) => s.column === 'tech');
const generalSources = initialSources.filter((s) => s.column === 'general');
const financeSources = initialSources.filter((s) => s.column === 'finance');
---

<div id="hot-news-container" class="space-y-6">
  <!-- Controls & Header Bar (Sticky Bar) -->
  <div class="sticky top-[53px] sm:top-[57px] z-30 rounded-xl border border-[var(--border-primary)] bg-[var(--card-bg)]/95 backdrop-blur-md p-3 sm:p-4 shadow-sm transition-all">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5 pb-2.5 border-b border-[var(--border-secondary)]">
      <div class="space-y-0.5">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-500/10 px-2.5 py-0.5 text-xs font-medium text-orange-600 dark:text-orange-400">
            <span class="h-1.5 w-1.5 rounded-full bg-orange-500 animate-pulse"></span>
            全网风向标
          </span>
          <span class="text-xs text-[var(--text-tertiary)] mono">
            聚合多平台实时榜单
          </span>
        </div>
        <p class="text-xs text-[var(--text-secondary)]">
          数据来源于 <a href="https://github.com/newsnext/newsnow" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--text-primary)]">newsnext/newsnow</a> · 实时动态抓取
        </p>
      </div>

      <!-- Action & Search -->
      <div class="flex items-center gap-2">
        <div class="relative flex-1 sm:w-56">
          <input
            id="hot-search-input"
            type="text"
            placeholder="搜索热点关键词..."
            class="w-full rounded-lg border border-[var(--border-primary)] bg-[var(--bg-secondary)] px-3 py-1.5 pl-8 text-xs text-[var(--text-primary)] placeholder-[var(--text-tertiary)] focus:border-[var(--accent)] focus:outline-hidden transition-colors"
          />
          <svg class="absolute left-2.5 top-2.5 h-3.5 w-3.5 text-[var(--text-tertiary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>

        <button
          id="btn-refresh-hot"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-primary)] bg-[var(--bg-secondary)] px-2.5 py-1.5 text-xs font-medium text-[var(--text-secondary)] transition-all hover:text-[var(--text-primary)] hover:border-[var(--text-secondary)] active:scale-95 shrink-0"
          title="刷新最新热榜"
        >
          <svg id="hot-refresh-spinner" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 4v6h-6"></path>
            <path d="M1 20v-6h6"></path>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          <span class="hidden sm:inline">刷新</span>
        </button>
      </div>
    </div>

    <!-- Category Switcher Tabs, Platform Dropdown & Density Limit Switcher -->
    <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2 text-xs font-medium">
      <!-- Category Switcher Tabs -->
      <div class="flex flex-wrap items-center gap-1 sm:gap-1.5">
        <button
          type="button"
          class="category-tab active rounded-md px-2.5 sm:px-3 py-1.5 transition-colors bg-[var(--bg-secondary)] text-[var(--accent)] font-semibold"
          data-category="all"
        >
          全部聚焦
        </button>
        <button
          type="button"
          class="category-tab rounded-md px-2 sm:px-2.5 py-1.5 transition-colors text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)] inline-flex items-center gap-1.5"
          data-category="tech"
        >
          <img src="/images/icons/tools.png" alt="极客科技" class="h-3.5 w-3.5 object-contain rounded-xs shrink-0" />
          <span>极客科技</span>
        </button>
        <button
          type="button"
          class="category-tab rounded-md px-2 sm:px-2.5 py-1.5 transition-colors text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)] inline-flex items-center gap-1.5"
          data-category="general"
        >
          <img src="/images/icons/globe.png" alt="全网社会" class="h-3.5 w-3.5 object-contain rounded-xs shrink-0" />
          <span>全网社会</span>
        </button>
        <button
          type="button"
          class="category-tab rounded-md px-2 sm:px-2.5 py-1.5 transition-colors text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)] inline-flex items-center gap-1.5"
          data-category="finance"
        >
          <img src="/images/icons/market.png" alt="商业财经" class="h-3.5 w-3.5 object-contain rounded-xs shrink-0" />
          <span>商业财经</span>
        </button>
      </div>

      <!-- Right Controls: Platform Dropdown & Density Switcher -->
      <div class="flex items-center gap-2">
        <!-- Platform Selector Dropdown -->
        <div class="relative" id="platform-dropdown-wrapper">
          <button
            id="platform-dropdown-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-primary)] bg-[var(--bg-secondary)] px-2.5 py-1 text-xs font-medium text-[var(--text-primary)] hover:border-[var(--text-secondary)] transition-all cursor-pointer shadow-2xs"
            aria-expanded="false"
            aria-haspopup="listbox"
            title="选择指定平台筛选"
          >
            <span id="platform-dropdown-dot" class="h-2 w-2 rounded-full bg-[var(--accent)] shrink-0"></span>
            <span id="platform-dropdown-label" class="max-w-[85px] sm:max-w-[110px] truncate">全部平台</span>
            <svg id="platform-dropdown-chevron" class="h-3.5 w-3.5 text-[var(--text-tertiary)] shrink-0 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- Dropdown Popover Menu -->
          <div
            id="platform-dropdown-menu"
            class="hidden absolute left-0 top-full mt-1.5 w-56 max-w-[calc(100vw-32px)] rounded-xl border border-[var(--border-primary)] bg-[var(--card-bg)]/98 backdrop-blur-md p-1.5 shadow-xl z-50 max-h-80 overflow-y-auto space-y-0.5 text-xs"
            role="listbox"
          >
            <button
              type="button"
              class="platform-select-item active w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-secondary)] transition-colors text-left font-medium text-[var(--accent)] bg-[var(--accent)]/10"
              data-platform="all"
              data-name="全部平台"
              data-color="var(--accent)"
            >
              <span class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-[var(--accent)]"></span>
                <span>全部平台 <span id="dropdown-all-count">({initialSources.length})</span></span>
              </span>
              <svg class="check-icon h-3.5 w-3.5 text-[var(--accent)] shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
              </svg>
            </button>

            <!-- Tech Category Group -->
            <div data-group-column="tech" class="category-group-header px-2 pt-2 pb-0.5 text-[10px] font-bold uppercase tracking-wider text-[var(--text-tertiary)] mono border-t border-[var(--border-secondary)]">
              极客科技
            </div>
            {techSources.map((source) => (
              <button
                type="button"
                class="platform-select-item w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-secondary)] transition-colors text-left text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
                data-platform={source.id}
                data-name={source.name}
                data-column={source.column}
                data-color={source.color}
              >
                <span class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full shrink-0" style={`background-color: ${source.color}`}></span>
                  <span>{source.name}</span>
                </span>
                <svg class="check-icon hidden h-3.5 w-3.5 text-[var(--accent)] shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
              </button>
            ))}

            <!-- General Category Group -->
            <div data-group-column="general" class="category-group-header px-2 pt-2 pb-0.5 text-[10px] font-bold uppercase tracking-wider text-[var(--text-tertiary)] mono border-t border-[var(--border-secondary)]">
              全网社会
            </div>
            {generalSources.map((source) => (
              <button
                type="button"
                class="platform-select-item w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-secondary)] transition-colors text-left text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
                data-platform={source.id}
                data-name={source.name}
                data-column={source.column}
                data-color={source.color}
              >
                <span class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full shrink-0" style={`background-color: ${source.color}`}></span>
                  <span>{source.name}</span>
                </span>
                <svg class="check-icon hidden h-3.5 w-3.5 text-[var(--accent)] shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
              </button>
            ))}

            <!-- Finance Category Group -->
            <div data-group-column="finance" class="category-group-header px-2 pt-2 pb-0.5 text-[10px] font-bold uppercase tracking-wider text-[var(--text-tertiary)] mono border-t border-[var(--border-secondary)]">
              商业财经
            </div>
            {financeSources.map((source) => (
              <button
                type="button"
                class="platform-select-item w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-secondary)] transition-colors text-left text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
                data-platform={source.id}
                data-name={source.name}
                data-column={source.column}
                data-color={source.color}
              >
                <span class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full shrink-0" style={`background-color: ${source.color}`}></span>
                  <span>{source.name}</span>
                </span>
                <svg class="check-icon hidden h-3.5 w-3.5 text-[var(--accent)] shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
              </button>
            ))}
          </div>
        </div>

        <!-- Density Limit Switcher -->
        <div class="inline-flex items-center gap-1 rounded-lg border border-[var(--border-primary)] bg-[var(--bg-secondary)] p-0.5 text-[11px] shrink-0">
          <span class="text-[var(--text-tertiary)] px-1.5 select-none text-[10px] font-normal hidden sm:inline">单榜展示:</span>
          <button
            type="button"
            class="density-btn rounded px-2 py-0.5 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            data-density="6"
            title="每平台最多展示前 6 条"
          >
            TOP 6
          </button>
          <button
            type="button"
            class="density-btn active rounded px-2 py-0.5 transition-all bg-[var(--card-bg)] text-[var(--text-primary)] font-semibold shadow-2xs"
            data-density="10"
            title="每平台最多展示前 10 条"
          >
            TOP 10
          </button>
          <button
            type="button"
            class="density-btn rounded px-2 py-0.5 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            data-density="all"
            title="展示全部条目"
          >
            全部
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Sources Grid & List View -->
  <div id="sources-container" class="space-y-6">
    {initialSources.map((source) => (
      <div
        class="source-block rounded-xl border border-[var(--border-primary)] bg-[var(--card-bg)] p-4 sm:p-5 shadow-xs transition-all"
        data-source-id={source.id}
        data-source-column={source.column}
      >
        <!-- Platform Header -->
        <div class="flex items-center justify-between pb-3 border-b border-[var(--border-secondary)] mb-3">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full" style={`background-color: ${source.color}`}></span>
            <h3 class="text-sm font-bold text-[var(--text-primary)]">
              {source.name}
            </h3>
            <span class="source-item-count mono text-[11px] text-[var(--text-tertiary)] bg-[var(--bg-secondary)] px-2 py-0.5 rounded">
              TOP {source.items.length}
            </span>
          </div>

          <a
            href={source.home}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors flex items-center gap-1"
          >
            <span>访问源站</span>
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>

        <!-- Items List -->
        <ul class="divide-y divide-[var(--border-secondary)]">
          {source.items.map((item, index) => {
            const rank = index + 1;
            const isTop3 = rank <= 3;
            return (
              <li
                class="hot-item group flex items-start gap-3 py-2.5 hover:bg-[var(--bg-secondary)]/40 rounded-lg px-2 -mx-2 transition-colors"
                data-rank={rank}
              >
                <!-- Rank Badge -->
                <span
                  class:list={[
                    'mono text-xs font-bold shrink-0 mt-0.5 flex h-5 w-5 items-center justify-center rounded',
                    rank === 1 ? 'bg-red-500 text-white' :
                    rank === 2 ? 'bg-orange-500 text-white' :
                    rank === 3 ? 'bg-amber-500 text-white' :
                    'text-[var(--text-tertiary)] bg-[var(--bg-secondary)] font-medium'
                  ]}
                >
                  {rank}
                </span>

                <!-- Title & Meta -->
                <div class="flex-1 min-w-0">
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hot-title text-sm text-[var(--text-primary)] hover:text-[var(--accent)] font-normal transition-colors line-clamp-2 leading-snug group-hover:underline"
                    title={item.extra?.hover || item.title}
                  >
                    {item.title}
                  </a>

                  {item.extra?.hover && (
                    <p class="text-[12px] text-[var(--text-tertiary)] line-clamp-1 mt-0.5">
                      {item.extra.hover}
                    </p>
                  )}
                </div>

                <!-- Heat / Stats Pill -->
                {item.extra?.info && (
                  <span class="mono text-[11px] text-[var(--text-tertiary)] group-hover:text-[var(--text-secondary)] shrink-0 mt-0.5 bg-[var(--bg-secondary)] px-1.5 py-0.5 rounded transition-colors">
                    {item.extra.info}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>

  <!-- Empty state for search -->
  <div id="search-empty-state" class="hidden rounded-xl border border-dashed border-[var(--border-primary)] p-8 text-center text-xs text-[var(--text-tertiary)]">
    未检索到与该关键词相关的实时热点
  </div>
</div>

<script>
  function setupHotNewsInteractions() {
    const dropdownWrapper = document.getElementById('platform-dropdown-wrapper');
    if (!dropdownWrapper || (dropdownWrapper as any)._hasHotNewsInteractions) return;
    (dropdownWrapper as any)._hasHotNewsInteractions = true;

    const densityBtns = document.querySelectorAll('.density-btn');
    const categoryTabs = document.querySelectorAll('.category-tab');
    const sourceBlocks = document.querySelectorAll('.source-block');
    const dropdownBtn = document.getElementById('platform-dropdown-btn');
    const dropdownMenu = document.getElementById('platform-dropdown-menu');
    const dropdownChevron = document.getElementById('platform-dropdown-chevron');
    const dropdownDot = document.getElementById('platform-dropdown-dot');
    const dropdownLabel = document.getElementById('platform-dropdown-label');
    const platformItems = document.querySelectorAll('.platform-select-item');
    const searchInput = document.getElementById('hot-search-input') as HTMLInputElement | null;
    const emptyState = document.getElementById('search-empty-state');
    const refreshBtn = document.getElementById('btn-refresh-hot');
    const spinner = document.getElementById('hot-refresh-spinner');

    let currentCategory = 'all';
    let currentPlatform = 'all';
    let currentSearch = '';
    let currentDensity = '10';
    try {
      currentDensity = localStorage.getItem('hotNewsDisplayDensity') || '10';
    } catch {}

    function applyDensity(density: string) {
      currentDensity = density;
      try {
        localStorage.setItem('hotNewsDisplayDensity', density);
      } catch {}

      // Update density buttons state
      densityBtns.forEach((btn) => {
        const b = btn as HTMLElement;
        if (b.dataset.density === density) {
          b.classList.add('active', 'bg-[var(--card-bg)]', 'text-[var(--text-primary)]', 'font-semibold', 'shadow-2xs');
          b.classList.remove('text-[var(--text-secondary)]');
        } else {
          b.classList.remove('active', 'bg-[var(--card-bg)]', 'text-[var(--text-primary)]', 'font-semibold', 'shadow-2xs');
          b.classList.add('text-[var(--text-secondary)]');
        }
      });

      // Update items in each block according to limit, or show however many exist
      sourceBlocks.forEach((block) => {
        const el = block as HTMLElement;
        const items = el.querySelectorAll('.hot-item');
        const badge = el.querySelector('.source-item-count');
        const limit = density === 'all' ? Infinity : parseInt(density, 10);

        let visibleCount = 0;
        items.forEach((item, idx) => {
          const itemEl = item as HTMLElement;
          const rank = idx + 1;
          if (rank <= limit) {
            itemEl.dataset.densityVisible = 'true';
            visibleCount++;
          } else {
            itemEl.dataset.densityVisible = 'false';
          }
        });

        // "没有就只展示那么多": Badge accurately reflects actual visible items
        if (badge) {
          badge.textContent = `TOP ${visibleCount}`;
        }
      });

      filterView();
    }

    function filterView() {
      let visibleCount = 0;

      sourceBlocks.forEach((block) => {
        const el = block as HTMLElement;
        const col = el.dataset.sourceColumn || '';
        const id = el.dataset.sourceId || '';

        // Match category
        const matchCategory = currentCategory === 'all' || col === currentCategory;
        // Match platform
        const matchPlatform = currentPlatform === 'all' || id === currentPlatform;

        // Match search query & density limit
        let matchQuery = true;
        const items = el.querySelectorAll('.hot-item');
        let matchedItemsInBlock = 0;

        items.forEach((item) => {
          const itemEl = item as HTMLElement;
          const text = (itemEl.querySelector('.hot-title')?.textContent || '').toLowerCase();
          const matchesQuery = !currentSearch || text.includes(currentSearch);
          const isDensityVisible = itemEl.dataset.densityVisible !== 'false';

          if (matchesQuery && (currentSearch ? true : isDensityVisible)) {
            itemEl.style.display = 'flex';
            matchedItemsInBlock++;
          } else {
            itemEl.style.display = 'none';
          }
        });

        if (currentSearch && matchedItemsInBlock === 0) {
          matchQuery = false;
        }

        if (matchCategory && matchPlatform && matchQuery) {
          el.style.display = 'block';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Density Buttons click
    densityBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const density = (btn as HTMLElement).dataset.density || '10';
        applyDensity(density);
      });
    });

    // Platform Dropdown Toggle Logic
    function toggleDropdown(open?: boolean) {
      const isCurrentlyOpen = !dropdownMenu?.classList.contains('hidden');
      const shouldOpen = open !== undefined ? open : !isCurrentlyOpen;

      if (shouldOpen) {
        dropdownMenu?.classList.remove('hidden');
        dropdownBtn?.setAttribute('aria-expanded', 'true');
        dropdownChevron?.classList.add('rotate-180');
      } else {
        dropdownMenu?.classList.add('hidden');
        dropdownBtn?.setAttribute('aria-expanded', 'false');
        dropdownChevron?.classList.remove('rotate-180');
      }
    }

    dropdownBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDropdown();
    });

    document.addEventListener('click', (e) => {
      if (!dropdownWrapper?.contains(e.target as Node)) {
        toggleDropdown(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleDropdown(false);
      }
    });

    // Function to set active platform
    function setPlatform(platformId: string, name: string, color?: string) {
      currentPlatform = platformId;

      if (dropdownLabel) dropdownLabel.textContent = name;
      if (dropdownDot && color) dropdownDot.style.backgroundColor = color;

      platformItems.forEach((item) => {
        const itemEl = item as HTMLElement;
        const checkIcon = itemEl.querySelector('.check-icon');
        const isSelected = itemEl.dataset.platform === platformId;

        if (isSelected) {
          itemEl.classList.add('active', 'text-[var(--accent)]', 'bg-[var(--accent)]/10', 'font-medium');
          itemEl.classList.remove('text-[var(--text-secondary)]');
          checkIcon?.classList.remove('hidden');
        } else {
          itemEl.classList.remove('active', 'text-[var(--accent)]', 'bg-[var(--accent)]/10', 'font-medium');
          itemEl.classList.add('text-[var(--text-secondary)]');
          checkIcon?.classList.add('hidden');
        }
      });

      toggleDropdown(false);
      filterView();
    }

    // Platform items click
    platformItems.forEach((item) => {
      item.addEventListener('click', () => {
        const itemEl = item as HTMLElement;
        const pid = itemEl.dataset.platform || 'all';
        const name = itemEl.dataset.name || '全部平台';
        const color = itemEl.dataset.color || 'var(--accent)';
        setPlatform(pid, name, color);
      });
    });

    // Category Tabs click
    categoryTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        categoryTabs.forEach((t) => {
          t.classList.remove('active', 'bg-[var(--bg-secondary)]', 'text-[var(--accent)]', 'font-semibold');
          t.classList.add('text-[var(--text-secondary)]');
        });
        tab.classList.add('active', 'bg-[var(--bg-secondary)]', 'text-[var(--accent)]', 'font-semibold');
        tab.classList.remove('text-[var(--text-secondary)]');

        currentCategory = (tab as HTMLElement).dataset.category || 'all';

        // Filter platform items inside dropdown to match current category
        let visibleCount = 0;
        platformItems.forEach((item) => {
          const itemEl = item as HTMLElement;
          const col = itemEl.dataset.column;
          if (itemEl.dataset.platform === 'all' || currentCategory === 'all' || col === currentCategory) {
            itemEl.style.display = 'flex';
            if (itemEl.dataset.platform !== 'all') visibleCount++;
          } else {
            itemEl.style.display = 'none';
          }
        });

        // Hide/show group headers inside dropdown
        const groupHeaders = dropdownMenu?.querySelectorAll('.category-group-header');
        groupHeaders?.forEach((h) => {
          const hEl = h as HTMLElement;
          const col = hEl.dataset.groupColumn;
          // Show all group headers if 'all' is selected, otherwise hide section titles for single category
          if (currentCategory === 'all') {
            hEl.style.display = 'block';
          } else {
            hEl.style.display = 'none';
          }
        });

        const allCountEl = document.getElementById('dropdown-all-count');
        if (allCountEl) {
          allCountEl.textContent = `(${visibleCount})`;
        }

        // Reset platform selection to all on category switch
        setPlatform('all', '全部平台', 'var(--accent)');
      });
    });

    // Search filter
    searchInput?.addEventListener('input', (e) => {
      currentSearch = ((e.target as HTMLInputElement).value || '').trim().toLowerCase();
      filterView();
    });

    // Live refresh via newsnow API proxy
    async function refreshHotNews(showSpinner = true) {
      if (showSpinner) spinner?.classList.add('animate-spin');
      try {
        const res = await fetch(`/api/hotnews.json?refresh=true&_t=${Date.now()}`);

        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data)) {
            data.forEach((s) => {
              const block = document.querySelector(`[data-source-id="${s.id}"]`);
              if (block && Array.isArray(s.items) && s.items.length > 0) {
                const list = block.querySelector('ul');
                if (list) {
                  list.innerHTML = s.items.slice(0, 25).map((item: any, idx: number) => {
                    const rank = idx + 1;
                    const rankClass = rank === 1 ? 'bg-red-500 text-white' :
                      rank === 2 ? 'bg-orange-500 text-white' :
                      rank === 3 ? 'bg-amber-500 text-white' :
                      'text-[var(--text-tertiary)] bg-[var(--bg-secondary)] font-medium';
                    return `
                      <li class="hot-item group flex items-start gap-3 py-2.5 hover:bg-[var(--bg-secondary)]/40 rounded-lg px-2 -mx-2 transition-colors" data-rank="${rank}">
                        <span class="mono text-xs font-bold shrink-0 mt-0.5 flex h-5 w-5 items-center justify-center rounded ${rankClass}">
                          ${rank}
                        </span>
                        <div class="flex-1 min-w-0">
                          <a href="${item.url}" target="_blank" rel="noopener noreferrer" class="hot-title text-sm text-[var(--text-primary)] hover:text-[var(--accent)] font-normal transition-colors line-clamp-2 leading-snug group-hover:underline">
                            ${item.title}
                          </a>
                          ${item.extra?.hover ? `<p class="text-[12px] text-[var(--text-tertiary)] line-clamp-1 mt-0.5">${item.extra.hover}</p>` : ''}
                        </div>
                        ${item.extra?.info ? `<span class="mono text-[11px] text-[var(--text-tertiary)] group-hover:text-[var(--text-secondary)] shrink-0 mt-0.5 bg-[var(--bg-secondary)] px-1.5 py-0.5 rounded transition-colors">${item.extra.info}</span>` : ''}
                      </li>
                    `;
                  }).join('');
                }
              }
            });
            applyDensity(currentDensity);
          }
        }
      } catch (err) {
        console.warn('Hot news refresh failed', err);
      } finally {
        if (showSpinner) {
          setTimeout(() => {
            spinner?.classList.remove('animate-spin');
          }, 500);
        }
      }
    }

    refreshBtn?.addEventListener('click', () => refreshHotNews(true));

    // Defer background refresh so tab switching and page interaction remain completely unblocked
    setTimeout(() => {
      const firstTitle = document.querySelector('.hot-title')?.textContent || '';
      if (
        firstTitle.includes('全国秋季气温') ||
        firstTitle.includes('热门聚焦') ||
        firstTitle.includes('新一代开源科技成果') ||
        firstTitle.includes('打工人周三劳逸结合')
      ) {
        refreshHotNews(false);
      }
    }, 2000);

    // Initialize with saved density
    applyDensity(currentDensity);
  }

  setupHotNewsInteractions();
  document.addEventListener('astro:page-load', setupHotNewsInteractions);
</script>
