---
import type { Daily60sHubData, HotNewsSource } from '../lib/newsService';

interface Props {
  hubData: Daily60sHubData;
  hotNewsSources?: HotNewsSource[];
}

const { hubData, hotNewsSources = [] } = Astro.props;
const digest = hubData?.digest || {
  date: '今日',
  dayOfWeek: '每日快讯',
  news: [],
  tip: '保持专注，敏锐前行。',
  updated: '实时同步'
};

// Select first 5 highlights for homepage preview
const previewNews = digest.news.slice(0, 5);

// Curate preview sources for hot news column (GitHub Trending, Weibo, CLS, V2EX)
const githubSource = hotNewsSources.find((s) => s.id === 'github');
const weiboSource = hotNewsSources.find((s) => s.id === 'weibo');
const clsSource = hotNewsSources.find((s) => s.id === 'cls-hot');
const v2exSource = hotNewsSources.find((s) => s.id === 'v2ex');

// Fallback preview items if hot news sources aren't loaded yet
const topGithubItems = githubSource?.items.slice(0, 2) || [
  { id: 'gh-1', title: 'anthropics/anthropic-quickstarts: 官方精选项目模板', url: 'https://github.com/trending' },
  { id: 'gh-2', title: 'vllm-project/vllm: 高吞吐易用的大模型推理与部署引擎', url: 'https://github.com/trending' }
];

const topWeiboItems = weiboSource?.items.slice(0, 2) || [
  { id: 'wb-1', title: '豆包对低认知人群有权威性 · 科技热议', url: 'https://weibo.com' },
  { id: 'wb-2', title: '90多年前30万人严守一个秘密 · 历史长波', url: 'https://weibo.com' }
];

const topClsItems = clsSource?.items.slice(0, 2) || [
  { id: 'cls-1', title: '美以领导人通话后商榷应对中东局势新方案', url: 'https://www.cls.cn' },
  { id: 'cls-2', title: '美联储官员强化鹰派立场：抗通胀之战尚未落幕', url: 'https://www.cls.cn' }
];
---

<section class="space-y-4">
  <!-- Section Title Bar -->
  <div class="flex items-center justify-between flex-wrap gap-2 border-b border-[var(--border-primary)] pb-3">
    <div class="flex items-center gap-2.5">
      <svg class="h-5 w-5 text-[var(--algo-amber,var(--accent))] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
        <path d="M4 12h3l2-6 4 12 2-6h5"></path>
      </svg>
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)] flex items-center gap-2">
          <span data-i18n="home.newsTitle">每日新闻 · 晨报与风向标</span>
        </h2>
      </div>
      <span id="home-digest-date-badge" class="mono text-[11px] font-semibold text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/25 px-2 py-0.5 hidden sm:inline" data-i18n-dayofweek data-date={digest.date} data-day={digest.dayOfWeek}>
        {digest.date} {digest.dayOfWeek}
      </span>
    </div>

    <a
      href="/news"
      class="mono text-xs sm:text-sm text-[var(--accent)] hover:underline flex items-center gap-1 font-medium group"
    >
      <span data-i18n="home.newsRadarLink" data-i18n-param-count={digest.news.length}>进入完整雷达 ({digest.news.length}条早报 · 15平台)</span>
      <span class="group-hover:translate-x-0.5 transition-transform">→</span>
    </a>
  </div>

  <!-- 2-Column Responsive Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
    <!-- Left Panel: 60s Daily Digest Highlights (7 cols) -->
    <div class="lg:col-span-7 border border-[var(--border-primary)] bg-[var(--card-bg)] p-4 sm:p-5 flex flex-col justify-between hover:border-[var(--accent)]/60 transition-colors">
      <div class="space-y-3">
        <!-- Card Header -->
        <div class="flex items-center justify-between pb-2.5 border-b border-[var(--border-secondary)]">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 bg-[var(--algo-crimson,#ef4444)]"></span>
            <span class="mono text-xs font-bold text-[var(--text-primary)] tracking-wide" data-i18n="home.newsTop5Title">
              60 秒晨读精选
            </span>
            <span class="text-[11px] text-[var(--text-tertiary)] mono">
              TOP 5
            </span>
          </div>
          <span id="home-digest-date-badge-2" class="text-[11px] text-[var(--text-tertiary)] mono">
            {digest.date}
          </span>
        </div>

        <!-- News Bullet List -->
        <ul id="home-preview-news-list" class="space-y-2.5 text-xs sm:text-sm leading-relaxed">
          {previewNews.map((item, idx) => (
            <li class="flex items-start gap-2.5 group">
              <span class="mono text-[11px] font-bold shrink-0 mt-0.5 flex h-5 w-5 items-center justify-center border border-[var(--border-primary)] bg-[var(--bg-secondary)] text-[var(--text-secondary)] group-hover:bg-[var(--accent)] group-hover:text-[var(--algo-on-green,#ffffff)] group-hover:border-[var(--accent)] transition-colors">
                {idx + 1}
              </span>
              <p class="text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-2">
                {item.replace(/^\d+[\.、\s]*/, '')}
              </p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Bottom Tip & Link -->
      <div class="mt-4 pt-3 border-t border-[var(--border-secondary)] space-y-2.5">
        {digest.tip && (
          <div class="border border-[var(--algo-amber,var(--border-secondary))]/35 bg-[var(--bg-secondary)] px-3 py-2 text-xs text-[var(--text-secondary)] flex items-start gap-2">
            <svg class="h-3.5 w-3.5 text-[var(--algo-amber,var(--accent))] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
              <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4"></path>
            </svg>
            <p id="home-digest-tip" class="line-clamp-2 leading-relaxed">
              <span class="font-medium text-[var(--text-primary)]" data-i18n="home.newsWhisper">微语：</span>{digest.tip.replace(/^【微语】\s*/, '')}
            </p>
          </div>
        )}
        <div class="flex items-center justify-between text-xs pt-0.5">
          <span class="text-[var(--text-tertiary)] text-[11px]" data-i18n="home.newsSyncHint">
            每日清晨持续同步全国与全球要闻
          </span>
          <a
            id="home-60s-read-all-link"
            href="/news#60s"
            class="mono text-[var(--accent)] hover:underline font-medium inline-flex items-center gap-1"
            data-i18n="home.newsReadAll"
            data-i18n-param-count={digest.news.length}
          >
            阅读全部 {digest.news.length} 条 →
          </a>
        </div>
      </div>
    </div>

    <!-- Right Panel: Real-time Hot Radar Preview (5 cols) -->
    <div class="lg:col-span-5 border border-[var(--border-primary)] bg-[var(--card-bg)] p-4 sm:p-5 flex flex-col justify-between hover:border-[var(--accent)]/60 transition-colors">
      <div class="space-y-3">
        <!-- Card Header -->
        <div class="flex items-center justify-between pb-2.5 border-b border-[var(--border-secondary)]">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full bg-[var(--accent)] opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 bg-[var(--accent)]"></span>
            </span>
            <span class="mono text-xs font-bold text-[var(--text-primary)] tracking-wide" data-i18n="home.newsTrendingTitle">
              全网风向标速递
            </span>
          </div>
          <span class="mono text-[11px] text-[var(--accent)] border border-[var(--accent)]/30 bg-[var(--accent)]/10 px-1.5 py-0.5" data-i18n="home.newsLive">
            实时抓取
          </span>
        </div>

        <!-- Curated Trends Preview -->
        <div class="space-y-3 text-xs">
          <!-- 1. GitHub Trending -->
          <div class="space-y-1">
            <div class="flex items-center justify-between text-[11px] text-[var(--text-tertiary)] font-medium">
              <span class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-[#181717] dark:bg-zinc-400"></span>
                <span class="font-semibold text-[var(--text-secondary)]" data-i18n="home.sourceGithub">GitHub Trending</span>
              </span>
              <a href="/news#hot" class="hover:text-[var(--accent)]" data-i18n="home.newsMore">更多</a>
            </div>
            <div id="home-hot-github-items" class="space-y-0.5">
              {topGithubItems.map((item, idx) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block truncate text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors py-0.5 leading-snug"
                >
                  <span class="mono text-[11px] text-[var(--text-tertiary)] mr-1">#{idx + 1}</span>
                  {item.title}
                </a>
              ))}
            </div>
          </div>

          <!-- 2. 微博热搜 -->
          <div class="space-y-1 pt-1.5 border-t border-[var(--border-secondary)]">
            <div class="flex items-center justify-between text-[11px] text-[var(--text-tertiary)] font-medium">
              <span class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-[#e6162d]"></span>
                <span class="font-semibold text-[var(--text-secondary)]" data-i18n="home.sourceWeibo">微博热搜榜</span>
              </span>
              <a href="/news#hot" class="hover:text-[var(--accent)]" data-i18n="home.newsMore">更多</a>
            </div>
            <div id="home-hot-weibo-items" class="space-y-0.5">
              {topWeiboItems.map((item, idx) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block truncate text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors py-0.5 leading-snug"
                >
                  <span class="mono text-[11px] text-[var(--text-tertiary)] mr-1">#{idx + 1}</span>
                  {item.title}
                </a>
              ))}
            </div>
          </div>

          <!-- 3. 财联社 -->
          <div class="space-y-1 pt-1.5 border-t border-[var(--border-secondary)]">
            <div class="flex items-center justify-between text-[11px] text-[var(--text-tertiary)] font-medium">
              <span class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-[#d9232e]"></span>
                <span class="font-semibold text-[var(--text-secondary)]" data-i18n="home.sourceCls">财联社热榜</span>
              </span>
              <a href="/news#hot" class="hover:text-[var(--accent)]" data-i18n="home.newsMore">更多</a>
            </div>
            <div id="home-hot-cls-items" class="space-y-0.5">
              {topClsItems.map((item, idx) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block truncate text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors py-0.5 leading-snug"
                >
                  <span class="mono text-[11px] text-[var(--text-tertiary)] mr-1">#{idx + 1}</span>
                  {item.title}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Card CTA Button -->
      <div class="mt-4 pt-3 border-t border-[var(--border-secondary)]">
        <a
          href="/news#hot"
          class="w-full py-2.5 px-3.5 border border-[var(--accent)] bg-[var(--bg-secondary)] hover:bg-[var(--accent)] hover:text-[var(--algo-on-green,#ffffff)] transition-all text-xs font-bold mono text-[var(--accent)] flex items-center justify-between group"
        >
          <span class="flex items-center gap-2">
            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
            <span data-i18n="home.newsBrowseAll">浏览 15 平台全部热榜 (300+ 条实时)</span>
          </span>
          <span class="group-hover:translate-x-0.5 transition-transform">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { t, getCurrentLang, formatDayOfWeek } from '../i18n';
  import { getCached60sSync, fetchCached60s, getCachedHotSync, fetchCachedHot, runWhenIdle } from '../lib/clientNewsCache';

  function apply60sToHomeDOM(data: any) {
    if (!data || !Array.isArray(data.news) || data.news.length === 0) return;

    const dateStr = data.date || '';
    const dayStr = data.day_of_week || '';
    const badge1 = document.getElementById('home-digest-date-badge');
    if (badge1 && dateStr) {
      badge1.setAttribute('data-date', dateStr);
      badge1.setAttribute('data-day', dayStr);
      badge1.textContent = `${dateStr} ${formatDayOfWeek(dayStr, getCurrentLang())}`;
    }

    const badge2 = document.getElementById('home-digest-date-badge-2');
    if (badge2 && dateStr) badge2.textContent = dateStr;

    const listEl = document.getElementById('home-preview-news-list');
    if (listEl) {
      const top5 = data.news.slice(0, 5);
      const firstClean = (top5[0] || '').replace(/^\d+[\.、\s]*/, '').trim();
      const currentFirst = listEl.querySelector('p')?.textContent?.trim() || '';
      if (firstClean && firstClean !== currentFirst) {
        listEl.innerHTML = top5.map((item: string, idx: number) => {
          const clean = item.replace(/^\d+[\.、\s]*/, '');
          return `
            <li class="flex items-start gap-2.5 group">
              <span class="mono text-[11px] font-bold shrink-0 mt-0.5 flex h-5 w-5 items-center justify-center border border-[var(--border-primary)] bg-[var(--bg-secondary)] text-[var(--text-secondary)] group-hover:bg-[var(--accent)] group-hover:text-[var(--algo-on-green,#ffffff)] group-hover:border-[var(--accent)] transition-colors">
                ${idx + 1}
              </span>
              <p class="text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-2">
                ${clean}
              </p>
            </li>
          `;
        }).join('');
      }
    }

    const tipEl = document.getElementById('home-digest-tip');
    if (tipEl && data.tip) {
      const whisper = t('home.newsWhisper', getCurrentLang());
      tipEl.innerHTML = `<span class="font-medium text-[var(--text-primary)]" data-i18n="home.newsWhisper">${whisper}</span>${data.tip.replace(/^【微语】\s*/, '')}`;
    }

    const readAllEl = document.getElementById('home-60s-read-all-link');
    if (readAllEl) {
      readAllEl.setAttribute('data-i18n-param-count', String(data.news.length));
      readAllEl.textContent = t('home.newsReadAll', getCurrentLang(), { count: data.news.length });
    }
  }

  function applyHotToHomeDOM(sources: any[]) {
    if (!Array.isArray(sources)) return;

    function renderItems(containerId: string, sourceId: string) {
      const s = sources.find((x: any) => x.id === sourceId);
      if (!s || !Array.isArray(s.items) || s.items.length === 0) return;
      const container = document.getElementById(containerId);
      if (!container) return;
      const top2 = s.items.slice(0, 2);
      container.innerHTML = top2.map((item: any, idx: number) => {
        return `
          <a
            href="${item.url}"
            target="_blank"
            rel="noopener noreferrer"
            class="block truncate text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors py-0.5 leading-snug"
          >
            <span class="mono text-[11px] text-[var(--text-tertiary)] mr-1">#${idx + 1}</span>
            ${item.title}
          </a>
        `;
      }).join('');
    }

    renderItems('home-hot-github-items', 'github');
    renderItems('home-hot-weibo-items', 'weibo');
    renderItems('home-hot-cls-items', 'cls-hot');
  }

  function setupHomeNewsSWR() {
    if (!document.getElementById('home-preview-news-list')) return;

    const cached60s = getCached60sSync();
    if (cached60s) {
      apply60sToHomeDOM(cached60s);
    } else {
      runWhenIdle(() => {
        fetchCached60s(false).then((data) => {
          if (data) apply60sToHomeDOM(data);
        });
      });
    }

    const cachedHot = getCachedHotSync();
    if (cachedHot) {
      applyHotToHomeDOM(cachedHot);
    } else {
      runWhenIdle(() => {
        fetchCachedHot(false).then((sources) => {
          if (sources) applyHotToHomeDOM(sources);
        });
      });
    }
  }

  setupHomeNewsSWR();
  document.addEventListener('astro:page-load', setupHomeNewsSWR);
</script>
