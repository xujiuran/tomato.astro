---
// MottoBanner.astro
interface Props {
  enMotto?: string;
  zhMotto?: string;
}

const {
  enMotto = "Be yourself and don't go with the flow.",
  zhMotto = "保持专注与敏锐，做有审美和价值的小事。"
} = Astro.props;
---

<div class="algo-motto relative overflow-hidden border border-[var(--border-primary)] bg-[var(--bg-secondary)] px-5 py-5 sm:py-6 my-7">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <p class="mono text-sm sm:text-base font-bold tracking-wide text-[var(--text-primary)]">
      <span class="text-[var(--algo-green,var(--accent))] mr-2">//</span>“ {enMotto} ”
    </p>
    <p class="text-xs sm:text-sm text-[var(--text-secondary)]" data-i18n="home.mottoZh">
      {zhMotto}
    </p>
  </div>
</div>
