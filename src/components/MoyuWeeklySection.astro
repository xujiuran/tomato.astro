---
// MoyuWeeklySection.astro
// Showcase component for the bottom of Homepage:
// 7-day work week strip, slacking philosophy quote, time progress bars, and holiday countdowns.
import type { MoyuData } from '../lib/newsService';

interface Props {
  moyu?: MoyuData | null;
}

const { moyu } = Astro.props;

// Safe percentage computation
const getPercentage = (val: any, fallback: number): number => {
  if (typeof val === 'number') return val;
  if (typeof val === 'string') return parseInt(val, 10) || fallback;
  if (val && typeof val.percentage === 'number') return val.percentage;
  return fallback;
};

const weekPercentage = getPercentage(moyu?.progress?.week, 43);
const monthPercentage = getPercentage(moyu?.progress?.month, 45);
const yearPercentage = getPercentage(moyu?.progress?.year, 79);

const daysToWeekend = moyu?.countdown?.weekend ?? 2;
const daysToNewYear = moyu?.countdown?.newYear ?? 78;
const daysToSpringFestival = moyu?.countdown?.springFestival ?? 112;
const daysToLaborDay = moyu?.countdown?.laborDay ?? 198;
const daysToNationalDay = moyu?.countdown?.nationalDay ?? 351;

const defaultQuote = '你在认真工作的时候，有人在摸鱼。你在加班的时候，有人在钓鱼。人生苦短，及时摸鱼。劳逸结合，才能行稳致远。';
const moyuQuote = moyu?.moyuQuote || defaultQuote;

// Compute 7 days of the current week (Monday to Sunday)
const baseDate = new Date();
const currentDay = baseDate.getDay(); // 0: Sunday, 1: Monday, ..., 6: Saturday
const dayOffset = currentDay === 0 ? 6 : currentDay - 1; // 0 for Monday, 6 for Sunday

const monday = new Date(baseDate);
monday.setDate(baseDate.getDate() - dayOffset);

const weekdayNames = ['周一', '周二', '周三', '周四', '周五', '周六', '周日'];
const weekdayTags = ['醒神开工', '火力全开', '胜利过半', '摸鱼充电', '坐等下班', '快乐双休', '养精蓄锐'];
const weekdayNameKeys = ['moyu.mon', 'moyu.tue', 'moyu.wed', 'moyu.thu', 'moyu.fri', 'moyu.sat', 'moyu.sun'];
const weekdayTagKeys = ['moyu.tagMon', 'moyu.tagTue', 'moyu.tagWed', 'moyu.tagThu', 'moyu.tagFri', 'moyu.tagSat', 'moyu.tagSun'];

const weekDays = weekdayNames.map((name, i) => {
  const d = new Date(monday);
  d.setDate(monday.getDate() + i);
  const isPast = i < dayOffset;
  const isToday = i === dayOffset;
  const isWeekend = i >= 5;
  const month = d.getMonth() + 1;
  const date = d.getDate();

  return {
    index: i,
    name,
    nameKey: weekdayNameKeys[i],
    dateStr: `${month}.${date}`,
    isPast,
    isToday,
    isWeekend,
    tag: weekdayTags[i],
    tagKey: weekdayTagKeys[i],
  };
});
---

<section id="moyu-weekly-section" class="cv-auto space-y-4">
  <!-- Header with title & badges -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-[var(--border-primary)] pb-3">
    <div class="flex items-center gap-2.5">
      <svg class="h-5 w-5 text-[var(--algo-green,var(--accent))] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
        <rect x="3" y="4" width="18" height="17"></rect>
        <path d="M8 2v4M16 2v4M3 10h18"></path>
      </svg>
      <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)] tracking-tight" data-i18n="home.moyuTitle">
        摸鱼周历 · 劳逸结合
      </h2>
      <span class="text-xs text-[var(--text-tertiary)] hidden md:inline" data-i18n="home.moyuSub">
        掌控工作节奏 · 享受从容生活
      </span>
    </div>

    <div class="flex items-center gap-3 text-xs mono">
      <span class="inline-flex items-center gap-1.5 border border-[var(--algo-green,var(--accent))]/40 bg-[var(--algo-green,var(--accent))]/10 px-2.5 py-0.5 text-[var(--algo-green,var(--accent))] font-semibold">
        <span class="h-1.5 w-1.5 bg-[var(--algo-green,var(--accent))]"></span>
        <span data-i18n="home.moyuDaysToWeekend" data-i18n-param-count={daysToWeekend}>距周末 {daysToWeekend} 天</span>
      </span>
      <a
        href="/news"
        class="text-[var(--accent)] hover:underline flex items-center gap-1 text-xs"
      >
        <span data-i18n="home.moyuNewsLink">每日早报与热榜</span>
        <span>→</span>
      </a>
    </div>
  </div>

  <!-- Main Container Panel -->
  <div class="border border-[var(--border-primary)] bg-[var(--card-bg)] p-4 sm:p-6 space-y-6 transition-all">
    
    <!-- 7-Day Week Sequencer Strip (Monday to Sunday) -->
    <div>
      <div class="flex items-center justify-between mb-3 text-xs text-[var(--text-secondary)]">
        <div class="flex items-center gap-2">
          <span class="font-bold text-[var(--text-primary)] mono" data-i18n="home.moyuScheduleTitle">本周工时日程</span>
          <span class="text-[11px] text-[var(--text-tertiary)]" data-i18n="home.moyuScheduleSub">周一至周日全景视图</span>
        </div>
        <div class="flex items-center gap-3 text-[11px] text-[var(--text-tertiary)] mono">
          <span class="flex items-center gap-1.5">
            <span class="h-2 w-2 bg-[var(--algo-green,#10b981)]"></span> <span data-i18n="home.moyuToday">今日</span>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="h-2 w-2 bg-[var(--algo-magenta,#f43f5e)]"></span> <span data-i18n="home.moyuWeekendTag">双休</span>
          </span>
        </div>
      </div>

      <div class="grid grid-cols-7 gap-1.5 sm:gap-2.5">
        {weekDays.map((d) => (
          <div
            class:list={[
              'moyu-week-day group relative p-2 sm:p-3 text-center transition-all border flex flex-col items-center justify-between min-h-[92px] sm:min-h-[105px]',
              d.isToday
                ? 'bg-[var(--algo-green,#10b981)]/12 border-[var(--algo-green,#10b981)] ring-1 ring-[var(--algo-green,#10b981)]/40'
                : d.isWeekend
                ? 'bg-[var(--algo-magenta,#f43f5e)]/8 border-[var(--algo-magenta,#f43f5e)]/35 hover:border-[var(--algo-magenta,#f43f5e)]'
                : d.isPast
                ? 'bg-[var(--bg-secondary)]/55 border-[var(--border-secondary)]'
                : 'bg-[var(--bg-secondary)] border-[var(--border-primary)] hover:border-[var(--accent)]/60',
            ]}
            data-day-index={d.index}
          >
            <!-- Today badge banner -->
            {d.isToday && (
              <span class="absolute -top-2.5 left-1/2 -translate-x-1/2 bg-[var(--algo-green,#10b981)] text-[var(--algo-on-green,#ffffff)] text-[9px] font-bold px-2 py-0.2 mono uppercase tracking-wider">
                NOW
              </span>
            )}

            <!-- Weekday Title -->
            <div class:list={[
              'text-xs sm:text-sm font-bold',
              d.isToday ? 'text-[var(--algo-green,#10b981)] font-extrabold' : d.isWeekend ? 'text-[var(--algo-magenta,#f43f5e)]' : 'text-[var(--text-primary)]'
            ]} data-i18n={d.nameKey}>
              {d.name}
            </div>

            <!-- Date Display -->
            <div class="moyu-day-date mono text-[11px] sm:text-xs text-[var(--text-tertiary)] my-1">
              {d.dateStr}
            </div>

            <!-- Fun Status Tag -->
            <div class:list={[
              'text-[10px] sm:text-[11px] px-1 sm:px-1.5 py-0.5 font-semibold leading-tight truncate w-full mono',
              d.isToday
                ? 'bg-[var(--algo-green,#10b981)] text-[var(--algo-on-green,#ffffff)]'
                : d.isWeekend
                ? 'bg-[var(--algo-magenta,#f43f5e)]/18 text-[var(--algo-magenta,#f43f5e)]'
                : d.isPast
                ? 'bg-[var(--bg-primary)] text-[var(--text-tertiary)]'
                : 'bg-[var(--card-bg)] text-[var(--text-secondary)] border border-[var(--border-secondary)]'
            ]} data-i18n={d.isPast && !d.isToday ? 'moyu.tagPast' : d.tagKey}>
              {d.isPast && !d.isToday ? '✓ 已过' : d.tag}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Slacking Philosophy Quote -->
    {moyuQuote && (
      <div class="border border-[var(--algo-green,var(--border-primary))]/35 bg-[var(--bg-secondary)] p-3.5 sm:p-4 text-xs sm:text-sm text-[var(--text-primary)] leading-relaxed">
        <div class="flex items-start gap-2.5">
          <span class="mono text-[var(--algo-green,var(--accent))] font-bold shrink-0">&gt;_</span>
          <div>
            <span class="mono font-bold text-[var(--algo-green,var(--accent))] mr-1.5" data-i18n="home.moyuPhilosophy">「摸鱼哲学」</span>
            <span class="text-[var(--text-secondary)] font-medium">{moyuQuote}</span>
          </div>
        </div>
      </div>
    )}

    <!-- Lower Section: Time Progress Bars & Holiday Countdowns -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 pt-2 border-t border-[var(--border-secondary)]">
      
      <!-- Left: Time Progress (7 cols on md) -->
      <div class="md:col-span-7 space-y-3.5">
        <div class="flex items-center justify-between text-xs">
          <div class="flex items-center gap-1.5 font-bold text-[var(--text-primary)] mono">
            <svg class="h-3.5 w-3.5 text-[var(--algo-green,var(--accent))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
            <span data-i18n="home.moyuTimeProgress">时光流逝进度</span>
          </div>
          <span class="mono text-[11px] text-[var(--text-tertiary)]" data-i18n="home.moyuBalance">流年不负 · 劳逸平衡</span>
        </div>

        <div class="space-y-3">
          <!-- Week Progress -->
          <div>
            <div class="flex justify-between text-xs text-[var(--text-secondary)] mb-1">
              <span class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 bg-[var(--algo-green,#10b981)]"></span>
                <span data-i18n="moyu.weekWorkProgress">本周工作进度</span>
              </span>
              <span class="mono font-bold text-[var(--algo-green,var(--text-primary))]">{weekPercentage}%</span>
            </div>
            <div class="h-2.5 w-full bg-[var(--bg-secondary)] border border-[var(--border-secondary)] overflow-hidden">
              <div
                class="h-full bg-[var(--algo-green,#10b981)] transition-all duration-700"
                style={`width: ${weekPercentage}%`}
              ></div>
            </div>
          </div>

          <!-- Month Progress -->
          <div>
            <div class="flex justify-between text-xs text-[var(--text-secondary)] mb-1">
              <span class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 bg-[var(--algo-magenta,#3b82f6)]"></span>
                <span data-i18n="moyu.monthNaturalProgress">本月自然日进度</span>
              </span>
              <span class="mono font-bold text-[var(--algo-magenta,var(--text-primary))]">{monthPercentage}%</span>
            </div>
            <div class="h-2.5 w-full bg-[var(--bg-secondary)] border border-[var(--border-secondary)] overflow-hidden">
              <div
                class="h-full bg-[var(--algo-magenta,#3b82f6)] transition-all duration-700"
                style={`width: ${monthPercentage}%`}
              ></div>
            </div>
          </div>

          <!-- Year Progress -->
          <div>
            <div class="flex justify-between text-xs text-[var(--text-secondary)] mb-1">
              <span class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 bg-[var(--algo-amber,#f97316)]"></span>
                <span data-i18n="moyu.yearGoneProgress">今年已逝进度</span>
              </span>
              <span class="mono font-bold text-[var(--algo-amber,var(--text-primary))]">{yearPercentage}%</span>
            </div>
            <div class="h-2.5 w-full bg-[var(--bg-secondary)] border border-[var(--border-secondary)] overflow-hidden">
              <div
                class="h-full bg-[var(--algo-amber,#f97316)] transition-all duration-700"
                style={`width: ${yearPercentage}%`}
              ></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Holiday Countdowns (5 cols on md) -->
      <div class="md:col-span-5 space-y-3">
        <div class="flex items-center justify-between text-xs">
          <div class="flex items-center gap-1.5 font-bold text-[var(--text-primary)] mono">
            <svg class="h-3.5 w-3.5 text-[var(--algo-amber,var(--accent))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
              <polygon points="12 2 15 9 22 9 16.5 14 18.5 21 12 17 5.5 21 7.5 14 2 9 9 9"></polygon>
            </svg>
            <span data-i18n="home.moyuFestiveGoals">节日倒计时目标</span>
          </div>
          <span class="text-[11px] text-[var(--text-tertiary)]" data-i18n="home.moyuAnticipation">期待与憧憬</span>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <!-- Weekend -->
          <div class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] p-2.5 text-center transition-colors hover:border-[var(--algo-green,#10b981)]">
            <p class="text-[11px] text-[var(--text-tertiary)]" data-i18n="moyu.weekend">距周末</p>
            <p class="text-xl font-extrabold mono text-[var(--algo-green,#10b981)] mt-0.5">
              {daysToWeekend} <span class="text-xs font-normal text-[var(--text-tertiary)]" data-i18n="moyu.daysUnit">天</span>
            </p>
          </div>

          <!-- New Year -->
          <div class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] p-2.5 text-center transition-colors hover:border-[var(--algo-amber,#3b82f6)]">
            <p class="text-[11px] text-[var(--text-tertiary)]" data-i18n="moyu.newYear">距元旦</p>
            <p class="text-xl font-extrabold mono text-[var(--algo-amber,#3b82f6)] mt-0.5">
              {daysToNewYear} <span class="text-xs font-normal text-[var(--text-tertiary)]" data-i18n="moyu.daysUnit">天</span>
            </p>
          </div>

          <!-- Spring Festival -->
          <div class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] p-2.5 text-center transition-colors hover:border-[var(--algo-magenta,#f43f5e)]">
            <p class="text-[11px] text-[var(--text-tertiary)]" data-i18n="moyu.springFestival">距春节</p>
            <p class="text-xl font-extrabold mono text-[var(--algo-magenta,#f43f5e)] mt-0.5">
              {daysToSpringFestival} <span class="text-xs font-normal text-[var(--text-tertiary)]" data-i18n="moyu.daysUnit">天</span>
            </p>
          </div>

          <!-- Labor Day -->
          <div class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] p-2.5 text-center transition-colors hover:border-[var(--algo-crimson,#6366f1)]">
            <p class="text-[11px] text-[var(--text-tertiary)]" data-i18n="moyu.laborDay">距劳动节</p>
            <p class="text-xl font-extrabold mono text-[var(--algo-crimson,#6366f1)] mt-0.5">
              {daysToLaborDay} <span class="text-xs font-normal text-[var(--text-tertiary)]" data-i18n="moyu.daysUnit">天</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupWeeklyCalendarSync() {
    const section = document.getElementById('moyu-weekly-section');
    if (!section) return;

    const now = new Date();
    const currentDay = now.getDay(); // 0 is Sunday, 1..6 is Mon..Sat
    const dayOffset = currentDay === 0 ? 6 : currentDay - 1; // 0 for Monday, 6 for Sunday

    const monday = new Date(now);
    monday.setDate(now.getDate() - dayOffset);

    const dayCards = section.querySelectorAll<HTMLElement>('.moyu-week-day');
    dayCards.forEach((card, index) => {
      const targetDate = new Date(monday);
      targetDate.setDate(monday.getDate() + index);

      const m = targetDate.getMonth() + 1;
      const d = targetDate.getDate();

      const dateEl = card.querySelector('.moyu-day-date');
      if (dateEl) {
        dateEl.textContent = `${m}.${d}`;
      }
    });
  }

  setupWeeklyCalendarSync();
  document.addEventListener('astro:page-load', setupWeeklyCalendarSync);
</script>
