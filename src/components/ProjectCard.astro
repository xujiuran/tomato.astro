---
// ProjectCard.astro
interface Props {
  name: string;
  desc: string;
  tags: string[];
  link: string;
  logoUrl?: string;
  icon?: string;
  stars?: string;
  badge?: string;
  highlight?: string;
  category?: string;
}

const { name, desc, tags, link, logoUrl, icon = '📦', stars, badge, highlight, category = 'all' } = Astro.props;

let domain = '';
try {
  domain = new URL(link).hostname.replace(/^www\./, '');
} catch {
  domain = link;
}
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="project-card group relative flex flex-col justify-between rounded-xl border border-[var(--border-primary)] bg-[var(--card-bg)] p-4 sm:p-5 transition-all duration-200 hover:-translate-y-1 hover:border-[var(--accent)] hover:shadow-md"
  data-category={category}
  data-name={name.toLowerCase()}
  data-desc={desc.toLowerCase()}
>
  <div>
    <!-- Top row: Real App Icon, Name, Badge, Outlink -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3 min-w-0">
        {logoUrl ? (
          <div class="h-11 w-11 rounded-xl bg-[var(--bg-secondary)] border border-[var(--border-secondary)] p-1.5 shrink-0 flex items-center justify-center overflow-hidden shadow-xs group-hover:scale-105 group-hover:shadow-sm transition-all duration-200">
            <img
              src={logoUrl}
              alt={`${name} app logo`}
              class="h-full w-full object-contain rounded-lg"
              loading="lazy"
            />
          </div>
        ) : (
          <span class="text-2xl shrink-0 p-1.5 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border-secondary)] transition-transform group-hover:scale-105">
            {icon}
          </span>
        )}
        <div class="min-w-0">
          <div class="flex items-center gap-1.5 flex-wrap">
            <h4 class="text-sm sm:text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors truncate">
              {name}
            </h4>
            {badge && (
              <span class="mono text-[10px] text-[var(--accent)] bg-[var(--accent)]/10 px-1.5 py-0.2 rounded font-medium">
                {badge}
              </span>
            )}
          </div>
          {stars && (
            <span class="inline-flex items-center gap-1 text-[11px] text-[var(--text-tertiary)] mono">
              ★ {stars}
            </span>
          )}
        </div>
      </div>

      <div class="flex items-center gap-1 shrink-0 text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors">
        <span class="text-xs group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">
          ↗
        </span>
      </div>
    </div>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-3">
      {desc}
    </p>

    <!-- Personal Recommendation Quote / Highlight -->
    {highlight && (
      <div class="rounded-lg bg-[var(--bg-secondary)]/80 border border-[var(--border-secondary)]/80 px-3 py-2 text-xs text-[var(--text-secondary)] mb-3 leading-normal flex items-start gap-2">
        <img src="/images/icons/thoughts.png" alt="心得" class="h-3.5 w-3.5 object-contain rounded-xs shrink-0 select-none mt-0.5 inline-block" />
        <div class="text-[11px] sm:text-xs text-[var(--text-primary)] font-normal">
          <span class="font-medium text-[var(--text-primary)]">推荐心得：</span>
          <span class="text-[var(--text-secondary)]">{highlight}</span>
        </div>
      </div>
    )}
  </div>

  <!-- Bottom: Tags & Link domain -->
  <div class="mt-auto pt-3 border-t border-[var(--border-secondary)] flex items-center justify-between gap-2">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="rounded bg-[var(--bg-secondary)] px-1.5 py-0.5 text-[10px] font-medium text-[var(--text-secondary)]">
          {tag}
        </span>
      ))}
    </div>
    <span class="mono text-[11px] text-[var(--text-tertiary)] shrink-0 flex items-center gap-1">
      <span>{domain}</span>
    </span>
  </div>
</a>
