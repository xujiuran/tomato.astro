---
// ProjectCard.astro
interface Props {
  name: string;
  desc: string;
  tags: string[];
  link: string;
  icon?: string;
  stars?: string;
}

const { name, desc, tags, link, icon = '📦', stars } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative flex flex-col justify-between rounded-xl border border-[var(--border-primary)] bg-[var(--card-bg)] p-4 transition-all hover:-translate-y-0.5 hover:border-[var(--text-secondary)] hover:shadow-xs"
>
  <div>
    <div class="flex items-center justify-between mb-2">
      <div class="flex items-center gap-2">
        <span class="text-xl">{icon}</span>
        <h4 class="text-sm sm:text-base font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
          {name}
        </h4>
      </div>
      {stars && (
        <span class="inline-flex items-center gap-1 text-[11px] text-[var(--text-secondary)] mono">
          ★ {stars}
        </span>
      )}
    </div>
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] line-clamp-2 leading-relaxed">
      {desc}
    </p>
  </div>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <span class="rounded bg-[var(--bg-secondary)] px-1.5 py-0.5 text-[10px] text-[var(--text-secondary)]">
        {tag}
      </span>
    ))}
  </div>
</a>
