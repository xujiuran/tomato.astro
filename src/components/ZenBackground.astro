---
// ZenBackground.astro
// 生成式“墨韵流川 / 枯山水微波”背景画布 (Inspired by generative aesthetics like antfu.me, but with original Zen Flow Lines)
// 特性：纯 Canvas 零外部依赖、自适应浅色/深色主题、边缘生发不干扰阅读、生成后自动休眠 0% CPU 占用
---

<canvas
  id="zen-bg-canvas"
  class="pointer-events-none fixed inset-0 z-0 h-full w-full opacity-80 transition-opacity duration-700"
  aria-hidden="true"
></canvas>

<script>
  // 简易 2D 梯度噪声（实现平滑流场，无需引入庞大的外部库）
  function createNoise() {
    const permutation = new Uint8Array(512);
    const p = new Uint8Array(256);
    for (let i = 0; i < 256; i++) p[i] = i;
    for (let i = 255; i > 0; i--) {
      const r = Math.floor(Math.random() * (i + 1));
      const t = p[i]; p[i] = p[r]; p[r] = t;
    }
    for (let i = 0; i < 512; i++) permutation[i] = p[i & 255];

    function fade(t: number) { return t * t * t * (t * (t * 6 - 15) + 10); }
    function lerp(t: number, a: number, b: number) { return a + t * (b - a); }
    function grad(hash: number, x: number, y: number) {
      const h = hash & 7;
      const u = h < 4 ? x : y;
      const v = h < 4 ? y : x;
      return ((h & 1) === 0 ? u : -u) + ((h & 2) === 0 ? v : -v);
    }

    return function noise2D(x: number, y: number): number {
      const X = Math.floor(x) & 255;
      const Y = Math.floor(y) & 255;
      const xf = x - Math.floor(x);
      const yf = y - Math.floor(y);
      const u = fade(xf);
      const v = fade(yf);
      const a = permutation[X] + Y;
      const aa = permutation[a];
      const ab = permutation[a + 1];
      const b = permutation[X + 1] + Y;
      const ba = permutation[b];
      const bb = permutation[b + 1];
      return lerp(v,
        lerp(u, grad(permutation[aa], xf, yf), grad(permutation[ba], xf - 1, yf)),
        lerp(u, grad(permutation[ab], xf, yf - 1), grad(permutation[bb], xf - 1, yf - 1))
      );
    };
  }

  interface StreamLine {
    x: number;
    y: number;
    prevX: number;
    prevY: number;
    age: number;
    maxAge: number;
    speed: number;
    width: number;
    color: string;
    flowOffset: number;
  }

  function initZenCanvas() {
    const canvas = document.getElementById('zen-bg-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    const noise2D = createNoise();
    let lines: StreamLine[] = [];
    let animationFrameId: number;
    let isDark = document.documentElement.classList.contains('dark');

    function getPalette() {
      isDark = document.documentElement.classList.contains('dark');
      return isDark
        ? {
            stroke: 'rgba(245, 245, 244, 0.05)',
            accent: 'rgba(249, 115, 22, 0.07)',
            dot: 'rgba(245, 245, 244, 0.15)',
          }
        : {
            stroke: 'rgba(28, 25, 23, 0.045)',
            accent: 'rgba(194, 65, 12, 0.06)',
            dot: 'rgba(120, 113, 108, 0.12)',
          };
    }

    // 初始化流线生成种子点（主要分布在四周与对角边缘，保持中间正文区干净透明）
    function spawnStreams() {
      lines = [];
      const colors = getPalette();
      const numStreams = Math.floor(Math.min(width, height) / 25) + 20;

      for (let i = 0; i < numStreams; i++) {
        // 从四条边或者对角线生发
        let x = 0;
        let y = 0;
        const side = Math.random();

        if (side < 0.35) {
          // 右侧边缘生发向左下流淌
          x = width * (0.7 + Math.random() * 0.3);
          y = height * Math.random() * 0.6;
        } else if (side < 0.7) {
          // 左侧边缘生发向右上流淌
          x = width * Math.random() * 0.3;
          y = height * (0.4 + Math.random() * 0.6);
        } else {
          // 顶底四周微风拂过
          x = Math.random() * width;
          y = Math.random() < 0.5 ? Math.random() * 80 : height - Math.random() * 80;
        }

        const isAccent = Math.random() < 0.18;

        lines.push({
          x,
          y,
          prevX: x,
          prevY: y,
          age: 0,
          maxAge: 200 + Math.random() * 300,
          speed: 1.2 + Math.random() * 1.6,
          width: 0.8 + Math.random() * 1.4,
          color: isAccent ? colors.accent : colors.stroke,
          flowOffset: Math.random() * 100,
        });
      }
    }

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      ctx?.clearRect(0, 0, width, height);
      spawnStreams();
    }

    // 绘制循环
    let activeLines = 0;

    function step() {
      if (!ctx) return;
      activeLines = 0;
      const noiseScale = 0.0018;

      for (const line of lines) {
        if (line.age >= line.maxAge) continue;
        activeLines++;

        line.prevX = line.x;
        line.prevY = line.y;

        // 依据流场噪声计算当前流向角
        const n = noise2D(line.x * noiseScale, line.y * noiseScale);
        const angle = n * Math.PI * 3.5 + (line.flowOffset * 0.01);

        line.x += Math.cos(angle) * line.speed;
        line.y += Math.sin(angle) * line.speed;
        line.age++;

        // 绘制本步平滑曲线片段
        ctx.beginPath();
        ctx.moveTo(line.prevX, line.prevY);
        ctx.lineTo(line.x, line.y);
        ctx.strokeStyle = line.color;
        ctx.lineWidth = line.width;
        ctx.lineCap = 'round';
        ctx.stroke();

        // 当流线末端衰减终止时，绘制微尘/水滴墨点
        if (line.age === Math.floor(line.maxAge * 0.95) && Math.random() < 0.4) {
          const colors = getPalette();
          ctx.beginPath();
          ctx.arc(line.x, line.y, line.width * 1.3, 0, Math.PI * 2);
          ctx.fillStyle = colors.dot;
          ctx.fill();
        }
      }

      // 如果所有流线都已完成生命周期，自动休眠停止调用，0% CPU 占用！
      if (activeLines > 0) {
        animationFrameId = requestAnimationFrame(step);
      }
    }

    // 重绘并重新生发
    function restart() {
      cancelAnimationFrame(animationFrameId);
      ctx?.clearRect(0, 0, width, height);
      spawnStreams();
      step();
    }

    window.addEventListener('resize', resize, { passive: true });

    // 监听暗黑模式切换，平滑重染流线
    const observer = new MutationObserver(() => {
      restart();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // 首次启动
    restart();

    // 页面卸载或重新路由时清理
    return () => {
      window.removeEventListener('resize', resize);
      observer.disconnect();
      cancelAnimationFrame(animationFrameId);
    };
  }

  // 绑定初始化
  let cleanup = initZenCanvas();
  document.addEventListener('astro:after-swap', () => {
    cleanup?.();
    cleanup = initZenCanvas();
  });
</script>
