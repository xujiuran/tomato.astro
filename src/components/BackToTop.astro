---

<button
  id="back-to-top"
  type="button"
  aria-label="回到顶部"
  class="fixed bottom-6 right-6 sm:bottom-8 sm:right-8 z-40 flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-full border border-[var(--border-primary)] bg-[var(--card-bg)]/90 text-[var(--text-secondary)] shadow-md backdrop-blur-md transition-all duration-300 ease-out opacity-0 pointer-events-none translate-y-3 scale-90 hover:border-[var(--accent)] hover:text-[var(--accent)] hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 active:scale-95 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-[var(--accent)] group"
  title="回到顶部"
>
  <!-- Circular Scroll Progress Ring -->
  <svg class="absolute inset-0 h-full w-full -rotate-90 p-0.5 pointer-events-none" viewBox="0 0 40 40">
    <circle
      cx="20"
      cy="20"
      r="17"
      fill="none"
      stroke="var(--border-secondary)"
      stroke-width="2"
      opacity="0.4"
    ></circle>
    <circle
      id="scroll-progress-ring"
      cx="20"
      cy="20"
      r="17"
      fill="none"
      stroke="var(--accent)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-dasharray="106.81"
      stroke-dashoffset="106.81"
      class="transition-all duration-150"
    ></circle>
  </svg>

  <!-- Arrow Up Icon -->
  <svg
    class="relative h-4 w-4 sm:h-4.5 sm:w-4.5 transition-transform duration-200 group-hover:-translate-y-0.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M18 15l-6-6-6 6"></path>
  </svg>
</button>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    const ring = document.getElementById('scroll-progress-ring');
    if (!btn) return;

    const circumference = 2 * Math.PI * 17; // ~106.81

    let ticking = false;

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY || document.documentElement.scrollTop;
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

          // Toggle visibility threshold (300px)
          if (scrollY > 300) {
            btn?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3', 'scale-90');
            btn?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
          } else {
            btn?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3', 'scale-90');
            btn?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
          }

          // Update progress ring
          if (ring && maxScroll > 0) {
            const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
            const offset = circumference - progress * circumference;
            ring.style.strokeDashoffset = `${offset}`;
          }

          ticking = false;
        });
        ticking = true;
      }
    }

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    // Run once initially
    onScroll();
  }

  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
