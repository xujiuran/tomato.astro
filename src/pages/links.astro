---
// links.astro - Friend Links & Blogroll Page
import BaseLayout from '../layouts/BaseLayout.astro';
import FriendCard from '../components/FriendCard.astro';
import MoyuCalendarSidebar from '../components/MoyuCalendarSidebar.astro';
import { getMoyuData } from '../lib/newsService';
import { friends, myBlogrollInfo } from '../data/friends';

const moyu = await getMoyuData();

const copyText = `博客名称：${myBlogrollInfo.name}
博客网址：${myBlogrollInfo.url}
博客简介：${myBlogrollInfo.description}
博客头像：${myBlogrollInfo.avatar}
RSS订阅：${myBlogrollInfo.feed}`;
---

<BaseLayout
  title="友情链接 · 伙伴们 · TomatoX 随笔"
  description="志同道合的数字花园与独立思考者。在去中心化的独立 Web 世界里，互相守望与连接。"
  currentPath="/links"
  containerClass="max-w-6xl"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Main Content (8 cols on lg) -->
    <div class="lg:col-span-8 min-w-0 space-y-8 pb-12">
      <!-- Header Section -->
      <div class="border-b border-[var(--border-secondary)] pb-5">
        <div class="flex items-center gap-2 mb-1.5">
          <span class="mono text-[11px] font-semibold text-[var(--accent)] tracking-wider uppercase bg-[var(--accent)]/10 px-2 py-0.5 rounded">
            Blogroll & Friends
          </span>
          <span class="mono text-xs text-[var(--text-tertiary)]">
            共 {friends.length} 位伙伴
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)] flex items-center gap-2.5">
          <img
            src="/images/icons/globe.png"
            alt="友情链接"
            class="h-7 w-7 sm:h-8 sm:w-8 object-contain inline-block shrink-0 rounded-lg shadow-xs"
          />
          <span>友情链接 · 伙伴们</span>
        </h1>
        <p class="mt-1 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed max-w-2xl">
          “海内存知己，天涯若比邻。” 在去中心化与算法推荐横行的时代，独立博客是数字世界里最真实纯净的避风港。记录彼此，互为连接。
        </p>
      </div>

      <!-- Friends Grid -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-secondary)] mono flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[var(--accent)]"></span>
            <span>特别推荐与同行者 ({friends.length})</span>
          </h2>
          <span class="text-xs text-[var(--text-tertiary)] mono">点击卡片直接访问</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {friends.map((friend) => (
            <FriendCard {...friend} />
          ))}
        </div>
      </section>

      <!-- Exchange Blogroll Info & Rules -->
      <section class="rounded-2xl border border-[var(--border-primary)] bg-[var(--card-bg)] p-5 sm:p-6 shadow-xs space-y-5">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="space-y-1">
            <h2 class="text-base sm:text-lg font-bold text-[var(--text-primary)] flex items-center gap-2">
              <svg class="h-5 w-5 text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <span>申请友链 & 本站信息</span>
            </h2>
            <p class="text-xs text-[var(--text-secondary)]">
              欢迎长期更新的技术、设计、独立思考与数字生活类独立博客交换友链。
            </p>
          </div>

          <!-- One-click Copy Button -->
          <button
            type="button"
            id="copy-blogroll-btn"
            data-copy-content={copyText}
            class="inline-flex items-center gap-1.5 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-secondary)] hover:border-[var(--accent)] px-3 py-1.5 text-xs font-medium text-[var(--text-primary)] transition-all cursor-pointer shadow-2xs active:scale-95"
            title="一键复制本站友链信息"
          >
            <svg id="copy-icon-normal" class="h-3.5 w-3.5 text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg id="copy-icon-success" class="h-3.5 w-3.5 text-emerald-500 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span id="copy-btn-text">一键复制本站信息</span>
          </button>
        </div>

        <!-- Info Detail Block -->
        <div class="rounded-xl border border-[var(--border-secondary)] bg-[var(--surface-subtle)] p-4 text-xs font-mono space-y-2 text-[var(--text-secondary)] select-all leading-relaxed">
          <div class="flex items-baseline gap-2">
            <span class="text-[var(--text-tertiary)] w-18 shrink-0">博客名称：</span>
            <span class="text-[var(--text-primary)] font-semibold font-sans">{myBlogrollInfo.name}</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-[var(--text-tertiary)] w-18 shrink-0">博客地址：</span>
            <span class="text-[var(--accent)]">{myBlogrollInfo.url}</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-[var(--text-tertiary)] w-18 shrink-0">博客简介：</span>
            <span class="text-[var(--text-primary)] font-sans">{myBlogrollInfo.description}</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-[var(--text-tertiary)] w-18 shrink-0">博客头像：</span>
            <span class="text-[var(--text-secondary)] truncate">{myBlogrollInfo.avatar}</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-[var(--text-tertiary)] w-18 shrink-0">RSS 订阅：</span>
            <span class="text-[var(--text-secondary)]">{myBlogrollInfo.feed}</span>
          </div>
        </div>

        <!-- Exchange Guideline Notes -->
        <div class="text-xs text-[var(--text-secondary)] space-y-2 leading-relaxed pt-2 border-t border-[var(--border-secondary)]">
          <h3 class="font-bold text-[var(--text-primary)] flex items-center gap-1.5">
            <span>💡 友链申请原则：</span>
          </h3>
          <ul class="list-disc pl-5 space-y-1 text-[var(--text-tertiary)]">
            <li>站点内容以<strong>原创技术实战、设计美学、思考随笔或生活沉淀</strong>为主；</li>
            <li>支持 HTTPS 访问，无大量恶性广告投放与未经授权的采集搬运；</li>
            <li>申请前请先将本站信息添加至您的友链中，并在 <a href="https://github.com/xujiuran" target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] underline font-medium">GitHub</a> 或邮件告知我，博主会在看到后第一时间回链！</li>
          </ul>
        </div>
      </section>
    </div>

    <!-- Right Companion Sidebar (4 cols on lg) -->
    <aside id="moyu-sidebar" class="lg:col-span-4 space-y-4">
      <MoyuCalendarSidebar moyu={moyu} />
    </aside>
  </div>
</BaseLayout>

<script>
  function setupCopyBlogroll() {
    const copyBtn = document.getElementById('copy-blogroll-btn');
    const copyText = document.getElementById('copy-btn-text');
    const iconNormal = document.getElementById('copy-icon-normal');
    const iconSuccess = document.getElementById('copy-icon-success');

    if (!copyBtn) return;

    copyBtn.onclick = () => {
      const content = copyBtn.getAttribute('data-copy-content') || '';
      navigator.clipboard.writeText(content).then(() => {
        if (copyText) copyText.textContent = '已复制到剪贴板！';
        iconNormal?.classList.add('hidden');
        iconSuccess?.classList.remove('hidden');

        setTimeout(() => {
          if (copyText) copyText.textContent = '一键复制本站信息';
          iconNormal?.classList.remove('hidden');
          iconSuccess?.classList.add('hidden');
        }, 2200);
      });
    };
  }

  setupCopyBlogroll();
  document.addEventListener('astro:page-load', setupCopyBlogroll);
</script>
