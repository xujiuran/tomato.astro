</BaseLayout>

<script>
  function setupAlgoraveBuffer() {
    const tabsWrap = document.getElementById('algo-lane-tabs');
    const bufferEl = document.getElementById('algo-code-buffer');
    if (!tabsWrap || !bufferEl) return;
    if ((tabsWrap as any)._hasAlgoHandler) return;
    (tabsWrap as any)._hasAlgoHandler = true;

    const buttons = tabsWrap.querySelectorAll<HTMLButtonElement>('.algo-lane-btn');
    const lines = bufferEl.querySelectorAll<HTMLElement>('.algo-code-line');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-lane') || 'all';
        buttons.forEach((b) => {
          const isCurrent = b === btn;
          b.className = isCurrent
            ? 'algo-lane-btn px-2 py-0.5 border border-[var(--algo-green)] bg-[var(--algo-green)]/15 text-[var(--algo-green)] font-bold cursor-pointer'
            : 'algo-lane-btn px-2 py-0.5 border border-transparent text-[var(--text-tertiary)] hover:text-[var(--text-primary)] cursor-pointer';
        });

        lines.forEach((line) => {
          const lane = line.getAttribute('data-line-lane') || 'all';
          if (selected === 'all' || lane === selected) {
            line.style.opacity = '1';
          } else {
            line.style.opacity = '0.32';
          }
        });
      });
    });
  }

  setupAlgoraveBuffer();
  document.addEventListener('astro:page-load', setupAlgoraveBuffer);
</script>
