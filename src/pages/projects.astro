---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

interface RecommendedProject {
  name: string;
  desc: string;
  highlight: string;
  tags: string[];
  link: string;
  icon: string;
  badge: string;
  category: 'productivity' | 'system' | 'health' | 'network';
}

const recommendedProjects: RecommendedProject[] = [
  {
    name: 'Mole',
    desc: '一套轻量深度、安全开源的 macOS 系统清理与空间管理套件，快速扫描大文件、卸载残留与开发废弃物。',
    highlight: '极简无后台常驻，精准定位各种应用卸载残留与 Node/Xcode 缓存，彻底告别 Mac 磁盘焦虑。',
    tags: ['macOS', '系统清理', '开源利器', '深度瘦身'],
    link: 'https://mole.fit/zh/',
    icon: '🧹',
    badge: 'macOS · 开源',
    category: 'system',
  },
  {
    name: 'Raycast',
    desc: 'macOS 革命性极速启动器与生产力中枢，替代原生 Spotlight，支持插件生态、剪贴板历史、AI 与快捷脚本。',
    highlight: '键盘流用户的终极效率利器，海量社区插件覆盖日常开发、窗口管理与搜索，效率倍增。',
    tags: ['macOS', '启动器', '生产力', '工作流'],
    link: 'https://www.raycast.com/',
    icon: '🚀',
    badge: '生产力核心',
    category: 'productivity',
  },
  {
    name: 'Easydict',
    desc: '简洁易用的 macOS 划词翻译与多引擎词典，开箱即用，支持数十种主流翻译引擎与大模型 AI 聚合对比。',
    highlight: '查词体验无与伦比，鼠标划词即显示多种翻译结果对比，阅读外文技术文档与英文源码的必备神器。',
    tags: ['macOS', '翻译查词', '开源', 'AI聚合'],
    link: 'https://github.com/tisfeng/easydict',
    icon: '📖',
    badge: '开源 · 划词翻译',
    category: 'productivity',
  },
  {
    name: 'Shui (喝水助手)',
    desc: '极简克制的 macOS 菜单栏喝水提醒与健康作息小工具，陪伴开发者在深度专注中保持规律补水。',
    highlight: '设计纯粹不打扰，支持自定义打卡节奏与优雅提示音，长程敲代码防亚健康的贴心伴侣。',
    tags: ['macOS', '菜单栏', '健康习惯', '开源'],
    link: 'https://github.com/rock-zhang/Shui',
    icon: '💧',
    badge: '开源 · 菜单栏',
    category: 'health',
  },
  {
    name: 'Clash Verge Rev',
    desc: '现代化的跨平台代理网络客户端，基于 Tauri 框架打造，界面优雅简洁，内存开销轻量，规则配置强大。',
    highlight: '相比老旧客户端更清爽快速，Tauri 原生级低资源占用，订阅管理与分流规则一目了然。',
    tags: ['跨平台', '网络分流', 'Tauri', '开源'],
    link: 'https://github.com/clash-verge-rev/clash-verge-rev',
    icon: '🌐',
    badge: '跨平台 · 网络利器',
    category: 'network',
  },
  {
    name: 'KeyStats',
    desc: '轻巧低占用的 macOS 键盘与鼠标输入统计应用，以直观热力图和图表记录每日敲击数据与打字习惯。',
    highlight: '满足极客对键入数据的好奇心，清晰查看代码输出密度与工作高峰时段，劳逸结合一览无余。',
    tags: ['macOS', '按键统计', '热力图', '开源'],
    link: 'https://github.com/debugtheworldbot/keyStats',
    icon: '⌨️',
    badge: '开源 · 数据洞察',
    category: 'health',
  },
  {
    name: 'Mos',
    desc: '让外接普通鼠标拥有媲美 macOS 妙控触控板的平滑顺畅滚动，支持滚轮独立反转和平滑插值算法。',
    highlight: '外接非苹果鼠标的必备救星，彻底消灭生硬滚动的顿挫感，网页与代码翻阅如同丝般顺滑。',
    tags: ['macOS', '平滑滚动', '外设优化', '开源'],
    link: 'https://github.com/Caldis/Mos',
    icon: '🖱️',
    badge: '开源 · 外设神器',
    category: 'system',
  },
];

const categories = [
  { id: 'all', label: '全部利器', count: recommendedProjects.length },
  { id: 'productivity', label: '🚀 效率与翻译', count: recommendedProjects.filter((p) => p.category === 'productivity').length },
  { id: 'system', label: '🛠️ 系统与外设', count: recommendedProjects.filter((p) => p.category === 'system').length },
  { id: 'health', label: '🌱 作息与健康', count: recommendedProjects.filter((p) => p.category === 'health').length },
  { id: 'network', label: '🌐 网络与分流', count: recommendedProjects.filter((p) => p.category === 'network').length },
];
---

<BaseLayout
  title="极客利器 · 推荐项目 · TomatoX 随笔"
  description="暂无个人开源作品，这里精选整理了伴随我日常高频使用、体验惊艳的优秀开源项目、生产力软件与数字生活利器。"
  currentPath="/projects"
>
  <div class="space-y-6 pb-12">
    <!-- Header Section -->
    <div class="border-b border-[var(--border-secondary)] pb-5">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="mono text-[11px] font-semibold text-[var(--accent)] tracking-wider uppercase bg-[var(--accent)]/10 px-2 py-0.5 rounded">
          Curated Toolkit & Apps
        </span>
        <span class="mono text-xs text-[var(--text-tertiary)]">
          共 {recommendedProjects.length} 款自用好物
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
        极客利器 · 推荐项目
      </h1>
      <p class="mt-1 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed max-w-2xl">
        “工欲善其事，必先利其器。” 暂无个人开源作品，这里真诚记录并分享我日常高频使用、体验极佳的优秀开源项目与生产力工具。
      </p>

      <!-- Search & Note banner -->
      <div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-3 border-t border-[var(--border-secondary)]">
        <div class="flex items-center gap-1.5 text-xs text-[var(--text-tertiary)]">
          <span>💡</span>
          <span>点击任意卡片可直达官网或 GitHub 源码仓库</span>
        </div>

        <div class="relative w-full sm:w-56">
          <input
            id="project-search-input"
            type="text"
            placeholder="搜索工具名称或关键词..."
            class="w-full rounded-lg border border-[var(--border-primary)] bg-[var(--bg-secondary)] px-3 py-1.5 pl-8 text-xs text-[var(--text-primary)] placeholder-[var(--text-tertiary)] focus:border-[var(--accent)] focus:outline-hidden transition-colors"
          />
          <svg class="absolute left-2.5 top-2.5 h-3.5 w-3.5 text-[var(--text-tertiary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
      </div>
    </div>

    <!-- Category Filter Tabs -->
    <div id="project-category-tabs" class="flex flex-wrap items-center gap-1.5 text-xs font-medium">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class:list={[
            'proj-cat-tab rounded-lg px-3 py-1.5 transition-all text-xs cursor-pointer',
            idx === 0
              ? 'active bg-[var(--accent)] text-white font-semibold'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]'
          ]}
          data-category={cat.id}
        >
          {cat.label} ({cat.count})
        </button>
      ))}
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {recommendedProjects.map((p) => (
        <ProjectCard {...p} />
      ))}
    </div>

    <!-- Empty search state -->
    <div id="projects-empty-state" class="hidden rounded-xl border border-dashed border-[var(--border-primary)] p-10 text-center">
      <span class="text-3xl">🔍</span>
      <p class="mt-2 text-sm font-semibold text-[var(--text-primary)]">未找到匹配的推荐利器</p>
      <p class="mt-1 text-xs text-[var(--text-tertiary)]">尝试更换关键词或切换到“全部利器”分类查看</p>
    </div>
  </div>
</BaseLayout>

<script>
  function setupProjectsFilter() {
    const tabs = document.querySelectorAll('.proj-cat-tab');
    const cards = document.querySelectorAll('.project-card');
    const searchInput = document.getElementById('project-search-input') as HTMLInputElement | null;
    const emptyState = document.getElementById('projects-empty-state');

    let currentCat = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.dataset.category || 'all';
        const name = el.dataset.name || '';
        const desc = el.dataset.desc || '';

        const matchCat = currentCat === 'all' || cat === currentCat;
        const matchSearch = !searchQuery || name.includes(searchQuery) || desc.includes(searchQuery);

        if (matchCat && matchSearch) {
          el.style.display = 'flex';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active', 'bg-[var(--accent)]', 'text-white', 'font-semibold');
          t.classList.add('text-[var(--text-secondary)]');
        });
        tab.classList.add('active', 'bg-[var(--accent)]', 'text-white', 'font-semibold');
        tab.classList.remove('text-[var(--text-secondary)]');

        currentCat = (tab as HTMLElement).dataset.category || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = ((e.target as HTMLInputElement).value || '').trim().toLowerCase();
      applyFilters();
    });
  }

  setupProjectsFilter();
  document.addEventListener('astro:page-load', setupProjectsFilter);
</script>
