---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Daily60sView from '../../components/Daily60sView.astro';
import HotNewsView from '../../components/HotNewsView.astro';
import MoyuCalendarSidebar from '../../components/MoyuCalendarSidebar.astro';
import { fetch60sHubData, fetchHotNews } from '../../lib/newsService';

// Fetch initial data at build time for instant loading and SEO
const [hubData, hotNewsSources] = await Promise.all([
  fetch60sHubData(),
  fetchHotNews(),
]);
const daily60sData = hubData.digest;
---

<BaseLayout
  title="每日新闻 · TomatoX 随笔"
  description="每日 60 秒看世界与全网实时热点风向标，整合科技极客、全网焦点与商业财经热门资讯。"
  currentPath="/news"
  containerClass="max-w-6xl"
>
  <div class="space-y-6 pb-12">
    <!-- Header Section -->
    <div class="border-b border-[var(--border-primary)] pb-5">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)] flex items-center gap-3 flex-wrap mono">
            <svg class="h-6 w-6 text-[var(--algo-amber)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
              <path d="M4 12h3l2-6 4 12 2-6h5"></path>
            </svg>
            <span data-i18n="news.title">每日早报</span>
            <span class="text-xs font-semibold text-[var(--algo-green)] border border-[var(--algo-green)]/35 bg-[var(--algo-green)]/10 px-2 py-0.5">
              {daily60sData.date}
            </span>
          </h1>
          <p class="mt-1.5 text-xs sm:text-sm text-[var(--text-secondary)]" data-i18n="news.sub">
            晨起 60 秒通读天下事，实时纵览全网极客与科技风向。
          </p>
        </div>

        <!-- Main Column Tabs: 60s vs Hot Radar -->
        <div class="inline-flex border border-[var(--border-primary)] bg-[var(--bg-secondary)] p-1 text-xs font-medium self-start sm:self-auto mono">
          <button
            id="tab-btn-60s"
            type="button"
            class="main-tab active flex items-center gap-1.5 px-3.5 py-1.5 transition-all bg-[var(--card-bg)] text-[var(--algo-green)] font-semibold cursor-pointer"
            data-target="section-60s"
          >
            <span class="flex items-center gap-1.5">
              <span data-i18n="news.daily60s">60秒早报</span>
            </span>
            <span class="text-[11px] bg-[var(--bg-secondary)] text-[var(--text-tertiary)] px-1.5 py-0.2">
              {daily60sData.news.length}
            </span>
          </button>
          <button
            id="tab-btn-hot"
            type="button"
            class="main-tab flex items-center gap-1.5 px-3.5 py-1.5 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer"
            data-target="section-hot"
          >
            <span class="flex items-center gap-1.5">
              <span data-i18n="news.hotNews">全网风向标</span>
            </span>
            <span class="text-[11px] bg-[var(--bg-secondary)] text-[var(--text-tertiary)] px-1.5 py-0.2">
              {hotNewsSources.length}平台
            </span>
          </button>
        </div>
      </div>
    </div>

    <!-- Real-time Freshness & Loading Status Bar -->
    <div id="news-status-bar" class="flex items-center justify-between border border-[var(--border-primary)] bg-[var(--card-bg)] px-3.5 py-2 text-xs mono">
      <div class="flex items-center gap-2">
        <span id="status-live-dot" class="inline-flex h-2 w-2 bg-[var(--algo-green)]"></span>
        <span id="status-message" class="text-[var(--text-secondary)] font-medium">
          实时连接中 · 正在聚合今日晨报与全网风向...
        </span>
      </div>
      <div class="flex items-center gap-2">
        <span id="status-timestamp" class="text-[11px] text-[var(--text-tertiary)] hidden sm:inline">
          刚刚同步
        </span>
      </div>
    </div>

    <!-- Main Content & Companion Sidebar Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Main Content Column (8 cols on lg) -->
      <div class="lg:col-span-8 min-w-0 space-y-6">
        <!-- Section 1: 60s Daily Digest -->
        <section id="section-60s" class="news-section">
          <Daily60sView initialHubData={hubData} />
        </section>

        <!-- Section 2: Hot News Radar -->
        <section id="section-hot" class="news-section hidden">
          <HotNewsView initialSources={hotNewsSources} />
        </section>
      </div>

      <!-- Right Companion Sidebar (4 cols on lg) -->
      <aside id="moyu-sidebar" class="lg:col-span-4 space-y-4">
        <MoyuCalendarSidebar moyu={hubData.moyu} />
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  function setupMainTabs() {
    const tab60s = document.getElementById('tab-btn-60s');
    const tabHot = document.getElementById('tab-btn-hot');
    const sec60s = document.getElementById('section-60s');
    const secHot = document.getElementById('section-hot');

    if (!tab60s || !tabHot || !sec60s || !secHot) return;

    function switchTab(is60s: boolean) {
      if (is60s) {
        tab60s?.classList.add('bg-[var(--card-bg)]', 'text-[var(--algo-green)]', 'font-semibold');
        tab60s?.classList.remove('text-[var(--text-secondary)]');

        tabHot?.classList.remove('bg-[var(--card-bg)]', 'text-[var(--algo-green)]', 'font-semibold');
        tabHot?.classList.add('text-[var(--text-secondary)]');

        sec60s?.classList.remove('hidden');
        secHot?.classList.add('hidden');
        history.replaceState(null, '', '#60s');
      } else {
        tabHot?.classList.add('bg-[var(--card-bg)]', 'text-[var(--algo-green)]', 'font-semibold');
        tabHot?.classList.remove('text-[var(--text-secondary)]');

        tab60s?.classList.remove('bg-[var(--card-bg)]', 'text-[var(--algo-green)]', 'font-semibold');
        tab60s?.classList.add('text-[var(--text-secondary)]');

        secHot?.classList.remove('hidden');
        sec60s?.classList.add('hidden');
        history.replaceState(null, '', '#hot');
      }
    }

    if ((tab60s as any)._hasMainTabListener) {
      if (window.location.hash === '#hot') switchTab(false);
      else if (window.location.hash === '#60s') switchTab(true);
      return;
    }
    (tab60s as any)._hasMainTabListener = true;

    tab60s.addEventListener('click', () => switchTab(true));
    tabHot.addEventListener('click', () => switchTab(false));

    // Support URL hash navigation
    if (window.location.hash === '#hot') {
      switchTab(false);
    }

    // Update real-time status indicator
    const statusMsg = document.getElementById('status-message');
    const statusTime = document.getElementById('status-timestamp');
    if (statusMsg) {
      statusMsg.textContent = '已连接实时源 · 今日 60s 晨报与全网热点已就绪';
    }
    if (statusTime) {
      const now = new Date();
      statusTime.textContent = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')} 同步`;
    }
  }

  setupMainTabs();
  document.addEventListener('astro:page-load', setupMainTabs);
</script>
