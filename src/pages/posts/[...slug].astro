---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MoyuCalendarSidebar from '../../components/MoyuCalendarSidebar.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import { fetch60sHubData } from '../../lib/newsService';
import { renderArticleMarkdown } from '../../lib/markdown';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { ...post },
  }));
}

const hubData = await fetch60sHubData();
const { title, date, readTime, words, content } = Astro.props;
const { html, toc } = renderArticleMarkdown(content);
---

<BaseLayout title={`${title} · TomatoX 随笔`} currentPath="/posts" containerClass="max-w-6xl">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Main Content (8 cols on lg) -->
    <div class="lg:col-span-8 min-w-0">
      <article class="space-y-6">
        <!-- Post Header -->
        <header class="border-b border-[var(--border-secondary)] pb-6 space-y-4">
          <div class="flex items-center gap-2 text-xs text-[var(--text-secondary)]">
            <a href="/posts" class="inline-flex items-center gap-1 text-[var(--accent)] hover:underline">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <span>返回文章列表</span>
            </a>
            <span>·</span>
            <time class="mono">{date}</time>
            <span>·</span>
            <span>约需 {readTime}</span>
            <span>·</span>
            <span>{words} 字</span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[var(--text-primary)] leading-tight">
            {title}
          </h1>
        </header>

        <!-- Post Body (Rendered with Mac Codeblocks & Markdown) -->
        <div class="article-content space-y-4" set:html={html} />

        <!-- Post Footer -->
        <footer class="mt-12 rounded-2xl border border-[var(--border-primary)] bg-[var(--surface-primary)] p-5 text-xs text-[var(--text-secondary)] space-y-2">
          <div class="flex items-center justify-between">
            <p>
              文章标题：<strong class="text-[var(--text-primary)]">{title}</strong>
            </p>
            <span class="mono text-[10px] text-[var(--text-tertiary)]">CC BY-SA 4.0</span>
          </div>
          <p class="text-[11px] text-[var(--text-tertiary)]">
            发布日期：{date} ｜ 欢迎转载，请保留出处并链接到原地址。
          </p>
        </footer>
      </article>
    </div>

    <!-- Right Companion Sidebar (4 cols on lg) -->
    <aside id="article-sidebar" class="lg:col-span-4 space-y-6">
      <!-- Article Table of Contents with reading progress & spy -->
      <ArticleToc toc={toc} title={title} />

      <!-- Moyu Calendar Companion -->
      <MoyuCalendarSidebar moyu={hubData.moyu} />
    </aside>
  </div>
</BaseLayout>
