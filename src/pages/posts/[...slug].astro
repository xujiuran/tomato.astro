---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MoyuCalendarSidebar from '../../components/MoyuCalendarSidebar.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import { fetch60sHubData } from '../../lib/newsService';
import { renderArticleMarkdown } from '../../lib/markdown';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post, idx) => ({
    params: { slug: post.slug },
    props: {
      ...post,
      prevPost: idx > 0 ? posts[idx - 1] : null,
      nextPost: idx < posts.length - 1 ? posts[idx + 1] : null,
    },
  }));
}

const hubData = await fetch60sHubData();
const { title, description, tag, date, readTime, words, content, prevPost, nextPost } = Astro.props;
const { html, toc } = renderArticleMarkdown(content);
const slug = Astro.params.slug;
const tocHeadings = toc.slice(0, 4).map((t) => t.text);

// Curated or auto-generated clean plain excerpt for share poster
const safeDescription = (description || content.replace(/<[^>]*>/g, '').replace(/[#*`>\[\]\(\)\-\_]/g, '').trim())
  .replace(/\s+/g, ' ')
  .slice(0, 130) + '...';
---

<BaseLayout title={`${title} · TomatoX 随笔`} currentPath="/posts" containerClass="max-w-6xl">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Main Content (8 cols on lg) -->
    <div class="lg:col-span-8 min-w-0">
      <article class="space-y-6">
        <!-- Post Header -->
        <header class="border-b border-[var(--border-secondary)] pb-6 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--text-secondary)]">
            <div class="flex flex-wrap items-center gap-2">
              <a href="/posts" class="inline-flex items-center gap-1 text-[var(--accent)] hover:underline">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                <span>返回文章列表</span>
              </a>
              <span>·</span>
              <time class="mono">{date}</time>
              <span>·</span>
              <span>约需 {readTime}</span>
              <span>·</span>
              <span>{words} 字</span>
            </div>

            <!-- Reading Actions: Font Size Adjuster & Share Poster -->
            <div class="flex items-center gap-2">
              <!-- Font Size Segmented Control -->
              <div class="flex items-center rounded-lg border border-[var(--border-secondary)] bg-[var(--surface-subtle)] p-0.5 text-xs select-none">
                <button
                  type="button"
                  data-font-size="sm"
                  class="font-size-btn px-2 py-0.5 rounded-md text-[11px] text-[var(--text-tertiary)] hover:text-[var(--text-primary)] transition-all cursor-pointer font-medium"
                  title="紧凑字号 (15px)"
                >
                  A-
                </button>
                <button
                  type="button"
                  data-font-size="base"
                  class="font-size-btn px-2 py-0.5 rounded-md text-[11px] text-[var(--text-primary)] bg-[var(--surface-primary)] shadow-2xs transition-all cursor-pointer font-semibold"
                  title="标准字号 (16px)"
                >
                  A
                </button>
                <button
                  type="button"
                  data-font-size="lg"
                  class="font-size-btn px-2 py-0.5 rounded-md text-[11px] text-[var(--text-tertiary)] hover:text-[var(--text-primary)] transition-all cursor-pointer font-medium"
                  title="舒适大字号 (18px)"
                >
                  A+
                </button>
              </div>

              <!-- Share Poster Button -->
              <button
                type="button"
                id="btn-post-share-poster"
                data-slug={slug}
                data-title={title}
                data-tag={tag || '深度长文'}
                data-date={date}
                data-read-time={readTime}
                data-words={words}
                data-description={safeDescription}
                data-toc={JSON.stringify(tocHeadings)}
                class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-secondary)] bg-[var(--surface-subtle)] hover:bg-[var(--surface-primary)] hover:border-[var(--accent)] px-2.5 py-1 text-xs text-[var(--text-secondary)] hover:text-[var(--accent)] transition-all cursor-pointer shadow-2xs"
                title="生成长图分享海报"
              >
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                  <polyline points="16 6 12 2 8 6"></polyline>
                  <line x1="12" y1="2" x2="12" y2="15"></line>
                </svg>
                <span>生成海报</span>
              </button>
            </div>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[var(--text-primary)] leading-tight">
            {title}
          </h1>
        </header>

        <!-- Post Body (Rendered with Mac Codeblocks & Markdown) -->
        <div class="article-content space-y-4" set:html={html} />

        <!-- Previous & Next Post Navigation -->
        {(prevPost || nextPost) && (
          <nav class="my-10 grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-[var(--border-secondary)]" aria-label="文章上下篇导航">
            {prevPost ? (
              <a
                href={`/posts/${prevPost.slug}`}
                class="group flex flex-col p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--surface-primary)] hover:border-[var(--accent)] hover:shadow-xs transition-all"
              >
                <span class="flex items-center gap-1.5 text-xs text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors mb-1 font-medium">
                  <svg class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                  </svg>
                  <span>上一篇</span>
                </span>
                <span class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-2">
                  {prevPost.title}
                </span>
                <span class="mt-2 text-[11px] text-[var(--text-tertiary)] mono">
                  {prevPost.date}
                </span>
              </a>
            ) : (
              <div class="hidden sm:block"></div>
            )}

            {nextPost && (
              <a
                href={`/posts/${nextPost.slug}`}
                class="group flex flex-col sm:items-end text-left sm:text-right p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--surface-primary)] hover:border-[var(--accent)] hover:shadow-xs transition-all"
              >
                <span class="flex items-center gap-1.5 text-xs text-[var(--text-tertiary)] group-hover:text-[var(--accent)] transition-colors mb-1 font-medium">
                  <span>下一篇</span>
                  <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
                <span class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-2">
                  {nextPost.title}
                </span>
                <span class="mt-2 text-[11px] text-[var(--text-tertiary)] mono">
                  {nextPost.date}
                </span>
              </a>
            )}
          </nav>
        )}

        <!-- Post Footer -->
        <footer class="mt-8 rounded-2xl border border-[var(--border-primary)] bg-[var(--surface-primary)] p-5 text-xs text-[var(--text-secondary)] space-y-2">
          <div class="flex items-center justify-between">
            <p>
              文章标题：<strong class="text-[var(--text-primary)]">{title}</strong>
            </p>
            <span class="mono text-[10px] text-[var(--text-tertiary)]">CC BY-SA 4.0</span>
          </div>
          <p class="text-[11px] text-[var(--text-tertiary)]">
            发布日期：{date} ｜ 欢迎转载，请保留出处并链接到原地址。
          </p>
        </footer>
      </article>
    </div>

    <!-- Right Companion Sidebar (4 cols on lg, sticky on desktop) -->
    <aside id="article-sidebar" class="lg:col-span-4 lg:sticky lg:top-20 space-y-5 self-start">
      <!-- Article Table of Contents with reading progress & spy -->
      <ArticleToc toc={toc} title={title} />

      <!-- Moyu Slacking Dashboard ("摸鱼工作周历 · 劳逸结合") -->
      <MoyuCalendarSidebar moyu={hubData.moyu} moyuOnly={true} />
    </aside>
  </div>
</BaseLayout>

<script>
  function initPostReadingToolkit() {
    const contentEl = document.querySelector('.article-content');
    const fontBtns = document.querySelectorAll('.font-size-btn');
    const sharePosterBtn = document.getElementById('btn-post-share-poster') as HTMLButtonElement | null;

    // 1. Font Size preference
    const savedSize = localStorage.getItem('tomatox_post_font_size') || 'base';
    applyFontSize(savedSize);

    function applyFontSize(size: string) {
      if (contentEl) {
        contentEl.setAttribute('data-font-size', size);
      }
      fontBtns.forEach((btn) => {
        const btnSize = btn.getAttribute('data-font-size');
        if (btnSize === size) {
          btn.classList.add('text-[var(--text-primary)]', 'bg-[var(--surface-primary)]', 'font-semibold', 'shadow-2xs');
          btn.classList.remove('text-[var(--text-tertiary)]');
        } else {
          btn.classList.remove('text-[var(--text-primary)]', 'bg-[var(--surface-primary)]', 'font-semibold', 'shadow-2xs');
          btn.classList.add('text-[var(--text-tertiary)]');
        }
      });
    }

    fontBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const size = btn.getAttribute('data-font-size') || 'base';
        localStorage.setItem('tomatox_post_font_size', size);
        applyFontSize(size);
      });
    });

    // 2. Open Share Poster (reads directly from active button data attributes to avoid stale state)
    if (sharePosterBtn) {
      sharePosterBtn.onclick = () => {
        const slug = sharePosterBtn.getAttribute('data-slug') || '';
        const title = sharePosterBtn.getAttribute('data-title') || document.title;
        const tag = sharePosterBtn.getAttribute('data-tag') || '深度长文';
        const date = sharePosterBtn.getAttribute('data-date') || '';
        const readTime = sharePosterBtn.getAttribute('data-read-time') || '5 分钟';
        const words = sharePosterBtn.getAttribute('data-words') || '2,000';
        const description = sharePosterBtn.getAttribute('data-description') || '';
        let toc: string[] = [];
        try {
          toc = JSON.parse(sharePosterBtn.getAttribute('data-toc') || '[]');
        } catch {
          toc = [];
        }

        window.dispatchEvent(
          new CustomEvent('tomatox:open-poster', {
            detail: {
              type: 'post',
              slug,
              title,
              tag,
              date,
              readTime,
              words,
              description,
              content: description,
              toc,
            },
          })
        );
      };
    }
  }

  initPostReadingToolkit();
  document.addEventListener('astro:page-load', initPostReadingToolkit);
</script>
