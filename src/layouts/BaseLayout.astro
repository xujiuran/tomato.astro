---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ZenBackground from '../components/ZenBackground.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = '墨羽 · 产品工程、AI Coding 与写作者',
  description = '记录全栈开发、AI 编码工作流、开源工具、设计与生活琐思。',
  currentPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="墨羽随笔 RSS" href="/rss.xml" />

    <!-- Anti-flicker dark mode script -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && systemDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="relative min-h-screen flex flex-col bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased transition-colors duration-200">
    <!-- Generative Zen Canvas Background (Ink Stream / Flow Field) -->
    <ZenBackground />

    <Header currentPath={currentPath} />

    <main id="main-content" class="relative z-10 flex-1 mx-auto w-full max-w-3xl px-4 sm:px-6 pt-6 sm:pt-10">
      <slot />
    </main>

    <div class="relative z-10">
      <Footer />
    </div>
  </body>
</html>
