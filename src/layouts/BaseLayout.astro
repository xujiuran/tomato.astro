---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ZenBackground from '../components/ZenBackground.astro';
import BackToTop from '../components/BackToTop.astro';
import CommandPalette from '../components/CommandPalette.astro';
import SharePosterModal from '../components/SharePosterModal.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  containerClass?: string;
}

const {
  title = 'TomatoX · 产品工程、AI Coding 与写作者',
  description = 'TomatoX 的个人博客 (xujiuran.top)，记录全栈开发、AI 编码工作流、开源工具、设计与生活琐思。',
  currentPath = '/',
  containerClass = 'max-w-6xl',
} = Astro.props;

const isAlgoraveHome = true;
---

<!doctype html>
<html lang="zh-CN" data-algorave="true">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={`https://xujiuran.top${currentPath}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="TomatoX 随笔 RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://news.xujiuran.top" crossorigin />
    <link rel="dns-prefetch" href="https://news.xujiuran.top" />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />

    <!-- Anti-flicker & persistent theme and language script across View Transitions -->
    <script is:inline>
      function applyTheme(targetDoc) {
        try {
          const doc = targetDoc || document;
          const stored = localStorage.getItem('theme');
          const isDark = stored === 'dark' || !stored;
          if (isDark) {
            doc.documentElement.classList.add('dark');
          } else {
            doc.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      }

      function applyStageMode(targetDoc) {
        try {
          const doc = targetDoc || document;
          doc.documentElement.setAttribute('data-algorave', 'true');
        } catch (_) {}
      }

      function applyLang(targetDoc) {
        try {
          const doc = targetDoc || document;
          const stored = localStorage.getItem('tomatox_lang');
          if (stored && ['zh-CN', 'en'].includes(stored)) {
            doc.documentElement.setAttribute('lang', stored);
          } else {
            doc.documentElement.setAttribute('lang', 'zh-CN');
          }
        } catch (_) {}
      }

      // 1. Initial execution on page load/refresh
      applyStageMode(document, window.location.pathname);
      applyTheme();
      applyLang();

      // 2. Before ClientRouter swaps documents, carry over theme, stage mode, and lang
      document.addEventListener('astro:before-swap', function (ev) {
        if (ev && ev.newDocument) {
          const nextPath = (ev.to && ev.to.pathname) || (ev.newDocument.location && ev.newDocument.location.pathname) || window.location.pathname;
          applyStageMode(ev.newDocument, nextPath);
          applyTheme(ev.newDocument);
          applyLang(ev.newDocument);
        }
      });

      // 3. Immediately after DOM swap fallback
      document.addEventListener('astro:after-swap', function () {
        applyStageMode(document, window.location.pathname);
        applyTheme(document);
        applyLang(document);
      });

      // 4. Real-time OS system theme listener
      try {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (ev) {
          if (!localStorage.getItem('theme')) {
            if (ev.matches) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
            window.dispatchEvent(new CustomEvent('tomatox:theme-change', { detail: { isDark: ev.matches } }));
          }
        });
      } catch (_) {}
    </script>
  </head>
  <body class="relative min-h-screen flex flex-col bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased">
    <!-- Smart non-blocking route loading progress indicator (only appears if network > 100ms) -->
    <div
      id="route-progress-bar"
      transition:persist="route-progress"
      aria-hidden="true"
      class="pointer-events-none fixed top-0 left-0 z-[200] h-[2px] w-0 bg-[var(--accent)] opacity-0 transition-[width,opacity] duration-200 ease-out"
    ></div>

    <!-- Generative Zen Canvas Background (Persisted across page transitions) -->
    <ZenBackground />

    <Header currentPath={currentPath} containerClass="max-w-6xl" />

    <main id="main-content" class:list={["relative z-10 flex-1 mx-auto w-full px-4 sm:px-6 pt-6 sm:pt-10", containerClass]}>
      <slot />
    </main>

    <div class="relative z-10" transition:persist="site-footer">
      <Footer containerClass="max-w-6xl" />
    </div>

    <!-- Floating Back to Top Button -->
    <BackToTop />

    <!-- Cmd + K Command Palette Modal -->
    <CommandPalette />

    <!-- One-click Share Poster Studio Modal -->
    <SharePosterModal />

    <script>
      import { fetchBatchViews, getCachedViewsMapSync, formatViewCount } from '../lib/viewsService';
      import { runWhenIdle } from '../lib/clientNewsCache';
      import { applyTranslationsToDOM, getCurrentLang } from '../i18n';

      function applyViewsMapToRoot(viewsMap: Record<string, number>, root: ParentNode = document) {
        const cardViewEls = root.querySelectorAll<HTMLElement>('.post-card-views[data-view-slug]');
        cardViewEls.forEach((el) => {
          const slug = el.getAttribute('data-view-slug');
          if (slug && typeof viewsMap[slug] === 'number') {
            const formatted = formatViewCount(viewsMap[slug]);
            if (el.textContent !== formatted) el.textContent = formatted;
          }
        });
      }

      // Smart route progress bar: 0ms overhead on cached pages, instant feedback if network > 90ms
      let progressTimer: ReturnType<typeof setTimeout> | null = null;
      let finishTimer: ReturnType<typeof setTimeout> | null = null;

      document.addEventListener('astro:before-preparation', () => {
        if (progressTimer) clearTimeout(progressTimer);
        if (finishTimer) clearTimeout(finishTimer);
        progressTimer = setTimeout(() => {
          const bar = document.getElementById('route-progress-bar');
          if (bar) {
            bar.style.transition = 'width 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 120ms ease';
            bar.style.opacity = '1';
            bar.style.width = '78%';
          }
        }, 90);
      });

      // Zero-flicker: Pre-translate & pre-hydrate cached views BEFORE ClientRouter swaps DOM!
      document.addEventListener('astro:before-swap', (ev: any) => {
        if (progressTimer) {
          clearTimeout(progressTimer);
          progressTimer = null;
        }
        const bar = document.getElementById('route-progress-bar');
        if (bar && bar.style.opacity === '1') {
          bar.style.width = '100%';
          finishTimer = setTimeout(() => {
            bar.style.opacity = '0';
            setTimeout(() => {
              bar.style.transition = 'none';
              bar.style.width = '0%';
            }, 180);
          }, 80);
        }

        if (ev && ev.newDocument) {
          const currentLang = getCurrentLang();
          applyTranslationsToDOM(currentLang, ev.newDocument);
          applyViewsMapToRoot(getCachedViewsMapSync(), ev.newDocument);
        }
      });

      function setupCardViewsTracker() {
        const cardViewEls = document.querySelectorAll<HTMLElement>('.post-card-views[data-view-slug]');
        if (!cardViewEls.length) return;

        // Paint synchronous local cache immediately
        applyViewsMapToRoot(getCachedViewsMapSync(), document);

        // Revalidate in idle time so navigation is never blocked
        runWhenIdle(() => {
          fetchBatchViews().then((viewsMap) => {
            applyViewsMapToRoot(viewsMap, document);
          });
        });
      }

      applyTranslationsToDOM();
      setupCardViewsTracker();

      document.addEventListener('astro:page-load', () => {
        applyTranslationsToDOM();
        setupCardViewsTracker();
      });
    </script>
  </body>
</html>
