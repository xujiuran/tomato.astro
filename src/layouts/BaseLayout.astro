---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ZenBackground from '../components/ZenBackground.astro';
import BackToTop from '../components/BackToTop.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  containerClass?: string;
}

const {
  title = 'TomatoX · 产品工程、AI Coding 与写作者',
  description = 'TomatoX 的个人博客 (xujiuran.top)，记录全栈开发、AI 编码工作流、开源工具、设计与生活琐思。',
  currentPath = '/',
  containerClass = 'max-w-6xl',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={`https://xujiuran.top${currentPath}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="TomatoX 随笔 RSS" href="/rss.xml" />
    <ClientRouter />

    <!-- Anti-flicker & persistent theme script across View Transitions -->
    <script is:inline>
      function applyTheme(targetDoc) {
        try {
          const doc = targetDoc || document;
          const stored = localStorage.getItem('theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = stored === 'dark' || (!stored && systemDark);
          if (isDark) {
            doc.documentElement.classList.add('dark');
          } else {
            doc.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      }

      // 1. Initial execution on page load/refresh
      applyTheme();

      // 2. Before ClientRouter swaps documents, carry over dark class to the incoming document
      document.addEventListener('astro:before-swap', function (ev) {
        if (ev && ev.newDocument) {
          applyTheme(ev.newDocument);
        }
      });

      // 3. Immediately after DOM swap fallback
      document.addEventListener('astro:after-swap', function () {
        applyTheme(document);
      });
    </script>
  </head>
  <body class="relative min-h-screen flex flex-col bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased transition-colors duration-200">
    <!-- Generative Zen Canvas Background (Ink Stream / Flow Field) -->
    <ZenBackground />

    <Header currentPath={currentPath} containerClass={containerClass} />

    <main id="main-content" class:list={["relative z-10 flex-1 mx-auto w-full px-4 sm:px-6 pt-6 sm:pt-10", containerClass]}>
      <slot />
    </main>

    <div class="relative z-10">
      <Footer containerClass={containerClass} />
    </div>

    <!-- Floating Back to Top Button -->
    <BackToTop />

    <!-- Cmd + K Command Palette Modal -->
    <CommandPalette />

    <!-- Global Route Navigation Progress Bar (Instant feedback on click) -->
    <div id="route-loading-bar" class="fixed top-0 left-0 right-0 h-[2.5px] z-[9999] opacity-0 pointer-events-none transition-opacity duration-300">
      <div id="route-loading-progress" class="h-full w-0 bg-gradient-to-r from-red-500 via-orange-500 to-amber-500 shadow-[0_0_8px_rgba(239,68,68,0.8)] transition-all duration-300 ease-out"></div>
    </div>

    <script>
      function setupRouteProgressBar() {
        const bar = document.getElementById('route-loading-bar');
        const progress = document.getElementById('route-loading-progress');
        if (!bar || !progress) return;

        document.addEventListener('astro:before-preparation', () => {
          bar.style.opacity = '1';
          progress.style.transition = 'width 350ms cubic-bezier(0.4, 0, 0.2, 1)';
          progress.style.width = '75%';
        });

        document.addEventListener('astro:page-load', () => {
          progress.style.transition = 'width 120ms ease-out';
          progress.style.width = '100%';
          setTimeout(() => {
            bar.style.opacity = '0';
            setTimeout(() => {
              progress.style.transition = 'none';
              progress.style.width = '0%';
            }, 300);
          }, 180);
        });
      }
      setupRouteProgressBar();
    </script>
  </body>
</html>
